@{
    Layout = null;
    string employeeName = ViewBag.EmployeeName;
    int year = ViewBag.Year;
    int month = ViewBag.Month;
    string monthLabel = ViewBag.MonthLabel;
    int totalCheckIns = ViewBag.TotalCheckIns;
    int expectedCheckIns = ViewBag.ExpectedCheckIns;
    int daysMissed = ViewBag.DaysMissed;
    int onTimeCount = ViewBag.OnTimeCount;
    int lateCount = ViewBag.LateCount;
    string nextScheduled = ViewBag.NextScheduled;
    var checkIns = ViewBag.CheckIns as List<FASSET.eCheckIn_v1.Models.CheckInReportRow>;
    var missedDates = ViewBag.MissedDates as List<string>;

    var prevMonthDate = new DateTime(year, month, 1).AddMonths(-1);
    var nextMonthDate = new DateTime(year, month, 1).AddMonths(1);
    double ratePercent = expectedCheckIns > 0 ? Math.Round(100.0 * totalCheckIns / expectedCheckIns, 1) : 0;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>FASSET&reg; - @employeeName - History</title>
    <style>
        @@import url('https://fonts.googleapis.com/css?family=Montserrat');

        .sidebar-pin-btn {
            background: none;
            border: none;
            color: rgba(255,255,255,0.6);
            cursor: pointer;
            padding: 6px;
            border-radius: 6px;
            flex-shrink: 0;
            margin-left: auto;
            opacity: 0;
            transition: opacity 0.15s ease, color 0.15s ease, background-color 0.15s ease;
        }

        .sidebar:hover .sidebar-pin-btn {
            opacity: 1;
        }

        .sidebar-pin-btn:hover {
            background: rgba(255,255,255,0.15);
            color: #fff;
        }

        .sidebar-pin-btn svg {
            width: 16px;
            height: 16px;
            display: block;
        }

        .sidebar.pinned .sidebar-pin-btn {
            color: #f2b705;
            opacity: 1;
        }

        .sidebar.pinned {
            width: 260px !important;
        }

            .sidebar.pinned .sidebar-brand-text,
            .sidebar.pinned .sidebar-section-label {
                opacity: 1;
            }

        .main-content {
            transition: margin-left 0.2s ease;
        }

        .sidebar.pinned ~ .main-content {
            margin-left: 260px;
        }


        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif;
            color: #23303d;
            background-color: #eef1f6;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 60px;
            overflow: hidden;
            white-space: nowrap;
            background: linear-gradient(180deg, #1b3f6e 0%, #16345c 55%, #12294a 100%);
            color: #fff;
            display: flex;
            flex-direction: column;
            z-index: 1000;
            transition: width 0.2s ease;
        }

        @@media (min-width: 993px) {
            .sidebar:hover {
                width: 260px;
            }
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 26px 14px;
        }

        .sidebar-logo {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            flex-shrink: 0;
            object-fit: contain;
        }

        .sidebar-brand-text {
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.08em;
            opacity: 0;
            white-space: nowrap;
            transition: opacity 0.15s ease;
        }

        .sidebar:hover .sidebar-brand-text {
            opacity: 1;
        }

        .sidebar-divider {
            height: 1px;
            background: rgba(255,255,255,0.18);
            margin: 4px 24px 14px;
        }

        .sidebar-nav {
            flex: 1;
            padding: 0 14px;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .sidebar-section-label {
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 0.09em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.45);
            padding: 16px 14px 6px;
            opacity: 0;
            white-space: nowrap;
            transition: opacity 0.15s ease;
        }

        .sidebar:hover .sidebar-section-label {
            opacity: 1;
        }

        .sidebar-section-label:first-child {
            padding-top: 4px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 14px;
            border-radius: 4px;
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 600;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            margin-bottom: 2px;
            white-space: nowrap;
        }

            .sidebar-link:hover {
                background: rgba(255,255,255,0.1);
            }

            .sidebar-link.active {
                background: rgba(255,255,255,0.16);
                color: #fff;
            }

        .main-content {
            margin-left: 60px;
        }

        .topnav {
            background: #fff;
            padding: 14px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #e6ebf1;
        }

        .topnav-title {
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #8792a3;
        }

            .topnav-title a {
                color: #8792a3;
                text-decoration: none;
            }

                .topnav-title a:hover {
                    color: #1b3f6e;
                }

        .typed-section {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 10px 16px;
            background: #fff;
            border-bottom: 1px solid #e6ebf1;
        }

            .typed-section p {
                font-family: 'Montserrat', sans-serif;
                font-size: 1.05rem;
                font-weight: bold;
                letter-spacing: 0.05rem;
                text-align: center;
                color: #1b3f6e;
                margin: 0;
            }

                .typed-section p span.typed-text {
                    font-weight: normal;
                    color: #ff5449;
                }

                .typed-section p span.cursor {
                    display: inline-block;
                    background-color: #7c8798;
                    margin-left: 0.1rem;
                    width: 3px;
                    animation: tagBlink 1s infinite;
                }

                    .typed-section p span.cursor.typing {
                        animation: none;
                    }

        @@keyframes tagBlink {
            0% {
                background-color: #7c8798;
            }

            49% {
                background-color: #7c8798;
            }

            50% {
                background-color: transparent;
            }

            99% {
                background-color: transparent;
            }

            100% {
                background-color: #7c8798;
            }
        }

        .page-header {
            padding: 28px 30px 0;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
        }

            .page-header h1 {
                font-size: 22px;
                font-weight: 700;
                color: #2a3646;
                margin: 0 0 4px;
            }

            .page-header p {
                font-size: 13px;
                color: #8792a3;
                margin: 0;
            }

        .month-nav {
            display: flex;
            align-items: center;
            gap: 14px;
            background: #fff;
            border: 1px solid #e6ebf1;
            border-radius: 10px;
            padding: 8px 16px;
        }

            .month-nav a {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 30px;
                height: 30px;
                border-radius: 6px;
                color: #1b3f6e;
                text-decoration: none;
                font-weight: 700;
                background: #f2f4f8;
            }

                .month-nav a:hover {
                    background: #e6ebf1;
                }

            .month-nav .month-label {
                font-size: 14px;
                font-weight: 700;
                color: #2a3646;
                min-width: 140px;
                text-align: center;
            }

        .kpi-row {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 18px;
            margin: 20px 30px;
        }

        @@media (max-width: 1100px) {
            .kpi-row {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (max-width: 700px) {
            .kpi-row {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .kpi-card {
            background: #fff;
            border: 1px solid #e6ebf1;
            border-radius: 14px;
            box-shadow: 0 8px 24px rgba(20,48,79,0.1);
            padding: 16px 18px;
        }

            .kpi-card.border-teal {
                border-left: 4px solid #16a3d1;
            }

            .kpi-card.border-gold {
                border-left: 4px solid #f2b705;
            }

            .kpi-card.border-red {
                border-left: 4px solid #e05043;
            }

            .kpi-card.border-green {
                border-left: 4px solid #2e9e4a;
            }

            .kpi-card.border-navy {
                border-left: 4px solid #1b3f6e;
            }

        .kpi-label {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: #99a3b3;
        }

        .kpi-value {
            font-size: 24px;
            font-weight: 700;
            color: #2a3646;
            margin-top: 4px;
        }

        .kpi-sub {
            font-size: 11.5px;
            color: #8792a3;
            margin-top: 4px;
        }

        .content-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin: 0 30px 30px;
        }

        @@media (max-width: 900px) {
            .content-grid {
                grid-template-columns: 1fr;
            }
        }

        .table-card {
            background: #fff;
            border: 1px solid #e6ebf1;
            border-radius: 14px;
            box-shadow: 0 4px 14px rgba(20,48,79,0.06);
            padding: 18px 20px;
        }

            .table-card h2 {
                font-size: 15.5px;
                font-weight: 700;
                margin: 0 0 14px;
                color: #2a3646;
            }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13.5px;
        }

        th {
            text-align: left;
            padding: 8px 10px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: #ff5449;
            border-bottom: 2px solid #f0f2f5;
        }

        td {
            padding: 8px 10px;
            border-bottom: 1px solid #f0f2f5;
            color: #445;
        }

        .empty-note {
            color: #99a3b3;
            font-size: 13px;
            padding: 10px 0;
        }

        .missed-list {
            list-style: none;
            margin: 0;
            padding: 0;
        }

            .missed-list li {
                padding: 7px 0;
                border-bottom: 1px solid #f0f2f5;
                font-size: 13.5px;
                color: #445;
            }

                .missed-list li:last-child {
                    border-bottom: none;
                }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-brand">
            <img src="~/Content/Small_Fasset.png" class="sidebar-logo" alt="FASSET" />
            <div class="sidebar-brand-text">FASSET</div>
            <button type="button" class="sidebar-pin-btn" onclick="toggleSidebarPin(event)" title="Pin sidebar open">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17v5M9 3h6l1 6-2 2H10l-2-2z" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
        </div>
        <div class="sidebar-divider"></div>
        <nav class="sidebar-nav">
            <div class="sidebar-section-label">Reports</div>
            <a href="@Url.Action("Index", "Reports")" class="sidebar-link">Dashboard</a>
            <a href="@Url.Action("AttendanceDetail", "Reports")" class="sidebar-link">Attendance Detail</a>

            <div class="sidebar-section-label">Manage</div>
            <a href="@Url.Action("Calendar", "Schedule")" class="sidebar-link">Schedule</a>
            <a href="@Url.Action("Index", "Employees")" class="sidebar-link">Employee Management</a>
            <a href="@Url.Action("Directory", "Employees")" class="sidebar-link active">FASSET Employees</a>

            <div class="sidebar-section-label">Account</div>
            <a href="@Url.Action("Index", "Settings")" class="sidebar-link">Settings</a>
            <a href="@Url.Action("CreateAdmin", "Account")" class="sidebar-link">Create Admin</a>
            <a href="#" class="sidebar-link" onclick="document.getElementById('logOutForm').submit(); return false;">Log Out</a>
            @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logOutForm", style = "display:none;" })) { }
        </nav>
    </div>

    <div class="main-content">
        <div class="topnav">
            <div class="topnav-title">
                <a href="@Url.Action("Index", "Reports")">FASSET&reg; CHECK-IN REPORTS</a> &rsaquo;
                <a href="@Url.Action("Directory", "Employees")">FASSET Employees</a> &rsaquo; @employeeName
            </div>
        </div>

        <div class="typed-section">
            <p>FASSET is <span class="typed-text"></span><span class="cursor">&nbsp;</span></p>
        </div>

        <div class="page-header">
            <div>
                <h1>@employeeName</h1>
                <p>Monthly check-in history and attendance summary</p>
            </div>
            <div class="month-nav">
                <a href="@Url.Action("History", "Employees", new { name = employeeName, year = prevMonthDate.Year, month = prevMonthDate.Month })">&larr;</a>
                <div class="month-label">@monthLabel</div>
                <a href="@Url.Action("History", "Employees", new { name = employeeName, year = nextMonthDate.Year, month = nextMonthDate.Month })">&rarr;</a>
            </div>
        </div>

        <div class="kpi-row">
            <div class="kpi-card border-teal">
                <div class="kpi-label">Total Check-Ins</div>
                <div class="kpi-value">@totalCheckIns</div>
            </div>
            <div class="kpi-card border-gold">
                <div class="kpi-label">Expected Check-Ins</div>
                <div class="kpi-value">@expectedCheckIns</div>
                <div class="kpi-sub">@ratePercent% attendance rate</div>
            </div>
            <div class="kpi-card border-red">
                <div class="kpi-label">Days Missed</div>
                <div class="kpi-value">@daysMissed</div>
            </div>
            <div class="kpi-card border-green">
                <div class="kpi-label">On Time / Late</div>
                <div class="kpi-value">@onTimeCount / @lateCount</div>
            </div>
            <div class="kpi-card border-navy">
                <div class="kpi-label">Next Scheduled</div>
                <div class="kpi-value" style="font-size:15px;">@nextScheduled</div>
            </div>
        </div>

        <div class="content-grid">
            <div class="table-card">
                <h2>Check-Ins &mdash; @monthLabel</h2>
                @if (checkIns == null || checkIns.Count == 0)
                {
                    <div class="empty-note">No check-ins recorded this month.</div>
                }
                else
                {
                    <table>
                        <thead>
                            <tr><th>Date</th><th>Time</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in checkIns)
                            {
                                bool isLate = c.DateCreated.TimeOfDay > new TimeSpan(9, 0, 0);
                                <tr>
                                    <td>@c.DateCreated.ToString("dddd, d MMMM")</td>
                                    <td>@c.DateCreated.ToString("HH:mm")</td>
                                    <td style="color:@(isLate ? "#e05043" : "#2e9e4a"); font-weight:600;">@(isLate ? "Late" : "On time")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="table-card">
                <h2>Missed Days &mdash; @monthLabel</h2>
                @if (missedDates == null || missedDates.Count == 0)
                {
                    <div class="empty-note">No missed days this month &mdash; every scheduled day was checked in.</div>
                }
                else
                {
                    <ul class="missed-list">
                        @foreach (var d in missedDates)
                        {
                            <li>@d</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <script>
        const typedTextSpan = document.querySelector(".typed-text");
        const cursorSpan = document.querySelector(".cursor");
        const textArray = [
            "e-CheckIn",
            "striving for excellence through hard work",
            "working with honesty and integrity",
            "making a difference",
            "valuing people",
            "innovation"
        ];
        const typingDelay = 60;
        const erasingDelay = 30;
        const newTextDelay = 2500;
        let textArrayIndex = 0;
        let charIndex = 0;

        function type() {
            if (charIndex < textArray[textArrayIndex].length) {
                if (!cursorSpan.classList.contains("typing")) cursorSpan.classList.add("typing");
                typedTextSpan.textContent += textArray[textArrayIndex].charAt(charIndex);
                charIndex++;
                setTimeout(type, typingDelay);
            } else {
                cursorSpan.classList.remove("typing");
                setTimeout(erase, newTextDelay);
            }
        }

        function erase() {
            if (charIndex > 0) {
                if (!cursorSpan.classList.contains("typing")) cursorSpan.classList.add("typing");
                typedTextSpan.textContent = textArray[textArrayIndex].substring(0, charIndex - 1);
                charIndex--;
                setTimeout(erase, erasingDelay);
            } else {
                cursorSpan.classList.remove("typing");
                textArrayIndex++;
                if (textArrayIndex >= textArray.length) textArrayIndex = 0;
                setTimeout(type, typingDelay + 1100);
            }
        }

        if (textArray.length && typedTextSpan && cursorSpan) {
            setTimeout(type, newTextDelay + 250);
        }

        function toggleSidebarPin(e) {
            e.stopPropagation();
            var sidebar = document.querySelector('.sidebar');
            var isPinned = sidebar.classList.toggle('pinned');
            localStorage.setItem('sidebarPinned', isPinned ? '1' : '0');
        }
        (function () {
            if (localStorage.getItem('sidebarPinned') === '1') {
                var sb = document.querySelector('.sidebar');
                if (sb) { sb.classList.add('pinned'); }
            }
        })();
    </script>
</body>
</html>
