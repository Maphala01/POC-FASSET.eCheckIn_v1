@using FASSET.eCheckIn_v1.Models
@{
    Layout = null;
    var employees = ViewBag.Employees as List<EmployeeDetail> ?? new List<EmployeeDetail>();
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>FASSET&reg; - Employee Management</title>
    <style>
        @@import url('https://fonts.googleapis.com/css?family=Montserrat');

        .sidebar-pin-btn {
            background: rgba(255,255,255,0.12);
            border: none;
            color: rgba(255,255,255,0.85);
            cursor: pointer;
            padding: 6px;
            border-radius: 6px;
            flex-shrink: 0;
            margin-left: auto;
            opacity: 0;
            transition: opacity 0.15s ease, color 0.15s ease, background-color 0.15s ease;
        }

        .sidebar:hover .sidebar-pin-btn {
            opacity: 1;
        }

        .sidebar-pin-btn:hover {
            background: rgba(255,255,255,0.15);
            color: #fff;
        }

        .sidebar-pin-btn svg {
            width: 18px;
            height: 18px;
            display: block;
            transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        /* Pinned = the pin is "pushed in", tilted like a real thumbtack.
           Unpinned = upright. */
        .sidebar.pinned .sidebar-pin-btn svg {
            transform: rotate(45deg);
        }

        .sidebar-pin-btn:active svg {
            transform: scale(0.82);
        }

        .sidebar.pinned .sidebar-pin-btn:active svg {
            transform: rotate(45deg) scale(0.82);
        }

        .sidebar.pinned .sidebar-pin-btn {
            color: #f2b705;
            opacity: 1;
        }

        .sidebar.pinned {
            width: 260px !important;
        }

            .sidebar.pinned .sidebar-brand-text,
            .sidebar.pinned .sidebar-section-label {
                opacity: 1;
            }

        .main-content {
            transition: margin-left 0.2s ease;
        }

        .sidebar.pinned ~ .main-content {
            margin-left: 260px;
        }


        .typed-section {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 10px 16px;
            background: #fff;
            border-bottom: 1px solid #e6ebf1;
        }

            .typed-section p {
                font-family: 'Montserrat', sans-serif;
                font-size: 1.05rem;
                font-weight: bold;
                letter-spacing: 0.05rem;
                text-align: center;
                color: #1b3f6e;
                margin: 0;
                line-height: 1.4;
                max-width: 100%;
                overflow-wrap: anywhere;
            }

                .typed-section p span.typed-text {
                    font-weight: normal;
                    color: #ff5449;
                }

                .typed-section p span.cursor {
                    display: inline-block;
                    background-color: #7c8798;
                    margin-left: 0.1rem;
                    width: 3px;
                    animation: tagBlink 1s infinite;
                }

                    .typed-section p span.cursor.typing {
                        animation: none;
                    }

        @@keyframes tagBlink {
            0% {
                background-color: #7c8798;
            }

            49% {
                background-color: #7c8798;
            }

            50% {
                background-color: transparent;
            }

            99% {
                background-color: transparent;
            }

            100% {
                background-color: #7c8798;
            }
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif;
            color: #23303d;
            background-color: #eef1f6;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 60px;
            overflow: hidden;
            white-space: nowrap;
            background: linear-gradient(180deg, #1b3f6e 0%, #16345c 55%, #12294a 100%);
            color: #fff;
            display: flex;
            flex-direction: column;
            z-index: 1000;
            transition: width 0.2s ease;
        }

        @@media (min-width: 993px) {
            .sidebar:hover {
                width: 260px;
            }
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 26px 14px;
        }

        .sidebar-logo {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            flex-shrink: 0;
            object-fit: contain;
        }

        .sidebar-brand-text {
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.08em;
            opacity: 0;
            white-space: nowrap;
            transition: opacity 0.15s ease;
        }

        .sidebar:hover .sidebar-brand-text {
            opacity: 1;
        }

        .sidebar-divider {
            height: 1px;
            background: rgba(255,255,255,0.18);
            margin: 4px 24px 14px;
        }

        .sidebar-nav {
            flex: 1;
            padding: 0 14px;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .sidebar-section-label {
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 0.09em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.45);
            padding: 16px 14px 6px;
            opacity: 0;
            white-space: nowrap;
            transition: opacity 0.15s ease;
        }

        .sidebar:hover .sidebar-section-label {
            opacity: 1;
        }

        .sidebar-section-label:first-child {
            padding-top: 4px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            padding: 12px 14px;
            border-radius: 8px;
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 600;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            margin-bottom: 2px;
            white-space: nowrap;
        }

        .sidebar:hover .sidebar-link, .sidebar.pinned .sidebar-link {
            justify-content: flex-start;
        }

        .sidebar-link svg {
            width: 18px;
            height: 18px;
            flex-shrink: 0;
            opacity: 0.9;
        }

        .sidebar-link:hover {
            background: rgba(255,255,255,0.1);
        }

        .sidebar-link.active {
            background: rgba(255,255,255,0.16);
            color: #fff;
        }

        .main-content {
            margin-left: 60px;
        }

        .topnav {
            background: #fff;
            padding: 14px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .topnav-gradient-line {
            height: 3px;
            width: 100%;
            background: linear-gradient(90deg, #ff5449, #f2b705, #16a3d1, #2e9e4a, #ff5449);
            background-size: 300% 100%;
            animation: titleUnderlineShift 4s linear infinite;
        }

        @@keyframes titleUnderlineShift {
            0% {
                background-position: 0% 50%;
            }

            100% {
                background-position: 300% 50%;
            }
        }

        .topnav-title {
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #8792a3;
        }

            .topnav-title a {
                color: #8792a3;
                text-decoration: none;
            }

                .topnav-title a:hover {
                    color: #1b3f6e;
                }

        .page-header {
            padding: 28px 30px 0;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
        }

            .page-header h1 {
                font-size: 22px;
                font-weight: 700;
                color: #2a3646;
                margin: 0 0 4px;
            }

            .page-header p {
                font-size: 13px;
                color: #8792a3;
                margin: 0;
            }

        #addEmployeeBtn {
            background: linear-gradient(135deg, #ff7a45, #ff5449);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 11px 20px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 3px 10px rgba(255,84,73,0.3);
        }

        .table-card {
            background: #fff;
            border: 1px solid #e6ebf1;
            border-radius: 14px;
            box-shadow: 0 4px 14px rgba(20,48,79,0.06);
            margin: 20px 30px 40px;
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13.5px;
        }

        th {
            text-align: left;
            padding: 12px 14px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: #ff5449;
            background: #fafbfc;
            border-bottom: 2px solid #f0f2f5;
        }

        td {
            padding: 12px 14px;
            border-bottom: 1px solid #f0f2f5;
            color: #445;
        }

        tbody tr:hover {
            background-color: #f7f9fb;
        }

        .status-pill {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 600;
        }

            .status-pill.active {
                background: #e6f6e9;
                color: #2e9e4a;
            }

            .status-pill.inactive {
                background: #fbe6e6;
                color: #a33333;
            }

        .row-actions button {
            border: 1px solid #dde3ea;
            background: #f7f9fb;
            color: #445;
            border-radius: 6px;
            padding: 5px 10px;
            font-size: 12px;
            cursor: pointer;
            margin-right: 6px;
        }

            .row-actions button:hover {
                background: #eef2f6;
            }

        .modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 40, 74, 0.6);
            z-index: 999999;
            align-items: center;
            justify-content: center;
        }

            .modal-backdrop.show {
                display: flex;
            }

        .modal-box {
            background: #fff;
            border-radius: 14px;
            max-width: 480px;
            width: 92%;
            box-shadow: 0 20px 50px rgba(0,0,0,0.35);
        }

        .modal-box-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 22px;
            border-bottom: 1px solid #eee;
        }

            .modal-box-header h3 {
                margin: 0;
                font-size: 16px;
                font-weight: 600;
                color: #1b3f6e;
            }

        .modal-close-btn {
            border: none;
            background: none;
            font-size: 20px;
            line-height: 1;
            color: #889;
            cursor: pointer;
            padding: 4px 8px;
        }

        .modal-box-body {
            padding: 20px 22px;
        }

        .form-field {
            margin-bottom: 14px;
        }

            .form-field label {
                display: block;
                font-size: 11.5px;
                font-weight: 600;
                color: #8792a3;
                text-transform: uppercase;
                letter-spacing: 0.03em;
                margin-bottom: 6px;
            }

            .form-field input, .form-field select {
                width: 100%;
                padding: 9px 11px;
                border: 1px solid #d7dde3;
                border-radius: 7px;
                font-size: 13.5px;
            }

                .form-field input:focus, .form-field select:focus {
                    outline: none;
                    border-color: #ff5449;
                }

        .modal-box-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding: 14px 22px;
            border-top: 1px solid #eee;
        }

            .modal-box-footer button {
                border-radius: 7px;
                padding: 9px 18px;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                border: none;
            }

        .btn-cancel {
            background: #f2f4f8;
            color: #556;
        }

        .btn-save {
            background: linear-gradient(135deg, #ff7a45, #ff5449);
            color: #fff;
        }

        .form-error {
            color: #a33333;
            font-size: 12.5px;
            margin-top: -8px;
            margin-bottom: 12px;
            display: none;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-brand">
            <img src="~/Content/Small_Fasset.png" class="sidebar-logo" alt="FASSET" />
            <div class="sidebar-brand-text">FASSET</div>
            <button type="button" class="sidebar-pin-btn" onclick="toggleSidebarPin(event)" title="Pin sidebar open">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="17" x2="12" y2="22"></line><path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z"></path></svg>
            </button>
        </div>
        <div class="sidebar-divider"></div>
        <nav class="sidebar-nav">
            <div class="sidebar-section-label">Check-In</div>
            <a href="@Url.Action("Index", "Registration")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="12" r="9" /></svg>
                Check In
            </a>

            <div class="sidebar-section-label">Reports</div>
            <a href="@Url.Action("Index", "Reports")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
                Dashboard
            </a>

            <div class="sidebar-section-label">Manage</div>
            <a href="@Url.Action("Calendar", "Schedule")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round" /><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01" stroke-linecap="round" /></svg>
                Schedule
            </a>
            <a href="@Url.Action("Index", "Employees")" class="sidebar-link active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0113 0" stroke-linecap="round" /><path d="M16 4.5a3.5 3.5 0 010 7M22 20a6 6 0 00-4.5-8.7" stroke-linecap="round" /></svg>
                Employee Management
            </a>
            <a href="@Url.Action("Directory", "Employees")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87M9 7a4 4 0 118 0 4 4 0 01-8 0z" stroke-linecap="round" stroke-linejoin="round" /><circle cx="9" cy="17" r="4" /></svg>
                FASSET Employees
            </a>

            <div class="sidebar-section-label">Account</div>
            <a href="@Url.Action("Index", "Settings")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z" /></svg>
                Settings
            </a>
            <a href="@Url.Action("CreateAdmin", "Account")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" stroke-linecap="round" /><circle cx="12" cy="7" r="4" /></svg>
                Create Admin
            </a>
            <a href="#" class="sidebar-link" onclick="document.getElementById('logOutForm').submit(); return false;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" stroke-linecap="round" stroke-linejoin="round" /><path d="M16 17l5-5-5-5M21 12H9" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Log Out
            </a>
            @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logOutForm", style = "display:none;" })) { }
        </nav>
    </div>

    <div class="main-content">
        <div class="topnav">
            <div class="topnav-title"><a href="@Url.Action("Index", "Reports")">FASSET&reg; CHECK-IN REPORTS</a> &rsaquo; Employee Management</div>
        </div>
        <div class="topnav-gradient-line"></div>

        <div class="typed-section">
            <p>FASSET is <span class="typed-text"></span><span class="cursor">&nbsp;</span></p>
        </div>

        <div class="page-header">
            <div>
                <h1>Employee Management</h1>
                <p>@employees.Count total employee@(employees.Count == 1 ? "" : "s") &mdash; add, edit, or deactivate</p>
            </div>
            <button type="button" id="addEmployeeBtn" onclick="openEmployeeModal()">+ Add Employee</button>
        </div>

        <div class="table-card">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Position</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="employeeTableBody">
                    @foreach (var e in employees)
                    {
                        <tr data-id="@(e.Id)" data-name="@(e.Name)" data-department="@(e.DepartmentName)" data-gender="@(e.Gender)" data-ethnicity="@(e.Ethnicity)" data-occlevel="@(e.OccupationalLevel)" data-position="@(e.Position)" data-active="@(e.IsActive.ToString().ToLower())">
                            <td><a href="@Url.Action("History", "Employees", new { name = e.Name })" style="color:#1b3f6e; text-decoration:underline;">@e.Name</a></td>
                            <td>@(string.IsNullOrWhiteSpace(e.DepartmentName) ? "-" : e.DepartmentName)</td>
                            <td>@(string.IsNullOrWhiteSpace(e.Position) ? "-" : e.Position)</td>
                            <td><span class="status-pill @(e.IsActive ? "active" : "inactive")">@(e.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="row-actions">
                                <button type="button" onclick="editEmployeeRow(this)">Edit</button>
                                <button type="button" onclick="toggleActiveRow(this)">@(e.IsActive ? "Deactivate" : "Activate")</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div id="employeeModalBackdrop" class="modal-backdrop" onclick="if (event.target === this) closeEmployeeModal();">
        <div class="modal-box">
            <div class="modal-box-header">
                <h3 id="employeeModalTitle">Add Employee</h3>
                <button type="button" class="modal-close-btn" onclick="closeEmployeeModal()">&times;</button>
            </div>
            <div class="modal-box-body">
                <div class="form-error" id="employeeFormError"></div>
                <input type="hidden" id="empId" value="" />
                <div class="form-field">
                    <label for="empName">Name</label>
                    <input type="text" id="empName" placeholder="Full name" />
                </div>
                <div class="form-field">
                    <label for="empDepartment">Department</label>
                    <select id="empDepartment">
                        <option value="">Select a department</option>
                        @foreach (var d in departments)
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="empPosition">Position</label>
                    <input type="text" id="empPosition" placeholder="e.g. Projects Administrator" />
                </div>
                <div class="form-field">
                    <label for="empOccLevel">Occupational Level</label>
                    <input type="text" id="empOccLevel" placeholder="e.g. Skilled, Management" />
                </div>
                <div class="form-field">
                    <label for="empGender">Gender</label>
                    <input type="text" id="empGender" />
                </div>
                <div class="form-field">
                    <label for="empEthnicity">Ethnicity</label>
                    <input type="text" id="empEthnicity" />
                </div>
            </div>
            <div class="modal-box-footer">
                <button type="button" class="btn-cancel" onclick="closeEmployeeModal()">Cancel</button>
                <button type="button" class="btn-save" onclick="saveEmployee()">Save</button>
            </div>
        </div>
    </div>

    <script>
        function getAntiForgeryToken() {
            var el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function openEmployeeModal() {
            document.getElementById('employeeModalTitle').textContent = 'Add Employee';
            document.getElementById('empId').value = '';
            document.getElementById('empName').value = '';
            document.getElementById('empDepartment').value = '';
            document.getElementById('empPosition').value = '';
            document.getElementById('empOccLevel').value = '';
            document.getElementById('empGender').value = '';
            document.getElementById('empEthnicity').value = '';
            document.getElementById('employeeFormError').style.display = 'none';
            document.getElementById('employeeModalBackdrop').classList.add('show');
        }

        function editEmployeeRow(btn) {
            var row = btn.closest('tr');
            document.getElementById('employeeModalTitle').textContent = 'Edit Employee';
            document.getElementById('empId').value = row.getAttribute('data-id');
            document.getElementById('empName').value = row.getAttribute('data-name') || '';
            document.getElementById('empDepartment').value = row.getAttribute('data-department') || '';
            document.getElementById('empPosition').value = row.getAttribute('data-position') || '';
            document.getElementById('empOccLevel').value = row.getAttribute('data-occlevel') || '';
            document.getElementById('empGender').value = row.getAttribute('data-gender') || '';
            document.getElementById('empEthnicity').value = row.getAttribute('data-ethnicity') || '';
            document.getElementById('employeeFormError').style.display = 'none';
            document.getElementById('employeeModalBackdrop').classList.add('show');
        }

        function closeEmployeeModal() {
            document.getElementById('employeeModalBackdrop').classList.remove('show');
        }

        function saveEmployee() {
            var id = document.getElementById('empId').value;
            var name = document.getElementById('empName').value.trim();
            var errorEl = document.getElementById('employeeFormError');

            if (!name) {
                errorEl.textContent = 'Name is required.';
                errorEl.style.display = 'block';
                return;
            }

            var payload = {
                name: name,
                departmentName: document.getElementById('empDepartment').value,
                position: document.getElementById('empPosition').value,
                occupationalLevel: document.getElementById('empOccLevel').value,
                gender: document.getElementById('empGender').value,
                ethnicity: document.getElementById('empEthnicity').value
            };

            var url = id ? '@Url.Action("Update", "Employees")' : '@Url.Action("Create", "Employees")';
            if (id) { payload.id = id; }

            var formBody = Object.keys(payload).map(function (k) {
                return encodeURIComponent(k) + '=' + encodeURIComponent(payload[k] || '');
            }).join('&');

            fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: withToken(formBody)
            })
            .then(function (res) { return res.json(); })
            .then(function (data) {
                if (data.success) {
                    location.reload();
                } else {
                    errorEl.textContent = data.message || 'Could not save employee.';
                    errorEl.style.display = 'block';
                }
            })
            .catch(function () {
                errorEl.textContent = 'Network error - could not save employee.';
                errorEl.style.display = 'block';
            });
        }

        function toggleActiveRow(btn) {
            var row = btn.closest('tr');
            var id = row.getAttribute('data-id');
            var currentlyActive = row.getAttribute('data-active') === 'true';
            var newActive = !currentlyActive;

            if (!confirm((newActive ? 'Activate' : 'Deactivate') + ' ' + row.getAttribute('data-name') + '?')) {
                return;
            }

            fetch('@Url.Action("ToggleActive", "Employees")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: withToken('id=' + encodeURIComponent(id) + '&isActive=' + newActive)
            })
            .then(function (res) { return res.json(); })
            .then(function (data) {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Could not update status.');
                }
            })
            .catch(function () {
                alert('Network error - could not update status.');
            });
        }

        const typedTextSpan = document.querySelector(".typed-text");
        const cursorSpan = document.querySelector(".cursor");
        const textArray = [
            "e-CheckIn",
            "striving for excellence through hard work",
            "working with honesty and integrity",
            "making a difference",
            "valuing people",
            "innovation"
        ];
        const typingDelay = 60;
        const erasingDelay = 30;
        const newTextDelay = 2500;
        let textArrayIndex = 0;
        let charIndex = 0;

        function type() {
            if (charIndex < textArray[textArrayIndex].length) {
                if (!cursorSpan.classList.contains("typing")) cursorSpan.classList.add("typing");
                typedTextSpan.textContent += textArray[textArrayIndex].charAt(charIndex);
                charIndex++;
                setTimeout(type, typingDelay);
            } else {
                cursorSpan.classList.remove("typing");
                setTimeout(erase, newTextDelay);
            }
        }

        function erase() {
            if (charIndex > 0) {
                if (!cursorSpan.classList.contains("typing")) cursorSpan.classList.add("typing");
                typedTextSpan.textContent = textArray[textArrayIndex].substring(0, charIndex - 1);
                charIndex--;
                setTimeout(erase, erasingDelay);
            } else {
                cursorSpan.classList.remove("typing");
                textArrayIndex++;
                if (textArrayIndex >= textArray.length) textArrayIndex = 0;
                setTimeout(type, typingDelay + 1100);
            }
        }

        if (textArray.length && typedTextSpan && cursorSpan) {
            setTimeout(type, newTextDelay + 250);
        }

        // MVC's [ValidateAntiForgeryToken] reads the token from the form BODY
        // (field name __RequestVerificationToken), not from a request header.
        function withToken(body) {
            return body + '&__RequestVerificationToken=' + encodeURIComponent(getAntiForgeryToken());
        }

        function toggleSidebarPin(e) {
            e.stopPropagation();
            var sidebar = document.querySelector('.sidebar');
            var isPinned = sidebar.classList.toggle('pinned');
            localStorage.setItem('sidebarPinned', isPinned ? '1' : '0');
        }
        (function () {
            if (localStorage.getItem('sidebarPinned') === '1') {
                var sb = document.querySelector('.sidebar');
                if (sb) { sb.classList.add('pinned'); }
            }
        })();
    </script>
    @Html.AntiForgeryToken()
</body>
</html>
