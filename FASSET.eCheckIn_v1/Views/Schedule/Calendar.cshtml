        /* ============================================================
           SCHEDULE CALENDAR CONTENT - unchanged from the existing
           Calendar view (month grid, day agenda, mobile responsiveness).
           Only re-housed inside the shared chrome above.
           ============================================================ */
        html, body {
            overflow-x: hidden;
            max-width: 100%;
        }

        .cal-wide-container {
            width: 100%;
            box-sizing: border-box;
        }

            .cal-wide-container, .cal-wide-container * {
                box-sizing: border-box;
            }

        .cal-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 18px;
        }

