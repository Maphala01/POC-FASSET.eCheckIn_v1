        /* ============================================================
           MOBILE: below this width the month grid becomes unreadable
           (7 columns squeeze to slivers). Switch to a vertical agenda:
           one card per day, stacked top to bottom, entries shown in
           full instead of truncated. Empty lead-in/trailing cells from
           the grid are hidden since they carry no information here.
           ============================================================ */
        @@media (max-width: 700px) {
            .cal-toolbar {
                justify-content: center;
                text-align: center;
            }

            .cal-title {
                min-width: 0;
            }

            .view-toggle {
                display: none;
            }

            #monthView {
                display: none !important;
            }

            #agendaView {
                display: block !important;
            }

            .cal-dow-row {
                display: none;
            }

            .cal-week-row {
                display: block;
                grid-template-columns: none;
                margin-bottom: 0;
            }

            .cal-cell {
                height: auto;
                min-height: 0;
                border-radius: 0;
                border-left: none;
                border-right: none;
                border-top: none;
                padding: 12px 4px;
                overflow: visible;
            }

                .cal-cell.empty {
                    display: none;
                }

            .cal-daynum {
                margin-bottom: 8px;
            }

            .cal-daynum-dow {
                display: inline;
            }

            .cal-entry-list {
                overflow-y: visible;
            }

            .cal-entry {
                white-space: normal;
                overflow-wrap: anywhere;
                word-break: break-word;
                width: 100%;
                max-width: 100%;
                font-size: 14px;
                line-height: 1.6;
                padding: 6px 10px;
            }

            .cal-cell, .cal-entry-list, .cal-week-row {
                width: 100%;
                max-width: 100%;
            }
        }
    </style>
</head>
<body>

    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="closeSidebar()"></div>

    <div class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <img src="~/Content/Small_Fasset.png" class="sidebar-logo" alt="FASSET" />
            <div class="sidebar-brand-text">FASSET</div>
            <button type="button" class="sidebar-pin-btn" onclick="toggleSidebarPin(event)" title="Pin sidebar open">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="17" x2="12" y2="22"></line><path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z"></path></svg>
            </button>
        </div>
        <div class="sidebar-divider"></div>
        <nav class="sidebar-nav">
            <div class="sidebar-section-label">Check-In</div>
            <a href="@Url.Action("Index", "Registration")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="12" r="9" /></svg>
                Check In
            </a>

            <div class="sidebar-section-label">Reports</div>
            <a href="@Url.Action("Index", "Reports")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
                Dashboard
            </a>
            <a href="@Url.Action("AttendanceDetail", "Reports")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M3 10h18M8 2v4M16 2v4" stroke-linecap="round" /></svg>
                Attendance Detail
            </a>

            <div class="sidebar-section-label">Manage</div>
            <a href="@Url.Action("Calendar", "Schedule")" class="sidebar-link active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round" /><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01" stroke-linecap="round" /></svg>
                Schedule
            </a>
            <a href="@Url.Action("Index", "Employees")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0113 0" stroke-linecap="round" /><path d="M16 4.5a3.5 3.5 0 010 7M22 20a6 6 0 00-4.5-8.7" stroke-linecap="round" /></svg>
                Employee Management
            </a>
            <a href="@Url.Action("Directory", "Employees")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87M9 7a4 4 0 118 0 4 4 0 01-8 0z" stroke-linecap="round" stroke-linejoin="round" /><circle cx="9" cy="17" r="4" /></svg>
                FASSET Employees
            </a>

            <div class="sidebar-section-label">Fasset Offices</div>
            @{ var fassetOffices = new[] { "Bank SETA", "FoodBev", "Tehwane South TVET College - Centurion Campus" }; }
            @foreach (var office in fassetOffices)
            {
                <a href="@Url.Action("Office", "Reports", new { name = office })" class="sidebar-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.5-7-11a7 7 0 0114 0c0 4.5-7 11-7 11z" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="10" r="2.5" /></svg>@office</a>
            }

            <div class="sidebar-section-label">Account</div>
            <a href="@Url.Action("Index", "Settings")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z" /></svg>
                Settings
            </a>
            <a href="@Url.Action("CreateAdmin", "Account")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" stroke-linecap="round" /><circle cx="12" cy="7" r="4" /></svg>
                Create Admin
            </a>
            <a href="#" class="sidebar-link" onclick="document.getElementById('logOutForm').submit(); return false;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" stroke-linecap="round" stroke-linejoin="round" /><path d="M16 17l5-5-5-5M21 12H9" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Log Out
            </a>
            @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logOutForm", style = "display:none;" })) { }
        </nav>
    </div>

    <div class="main-content">
        <div class="topnav">
            <div class="topnav-left">
                <button type="button" class="sidebar-toggle-btn" onclick="openSidebar()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b3f6e" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" /></svg>
                </button>
                <div class="topnav-title">FASSET&reg; CHECK-IN REPORTS <span style="opacity:0.45;">&rsaquo;</span> SCHEDULE</div>
            </div>
            <div class="topnav-right">
                <button type="button" class="topnav-icon-btn" title="Refresh" onclick="location.reload()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0115.3-6.4L21 8M3 12a9 9 0 0015.3 6.4L21 16M21 3v5h-5M3 21v-5h5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
            </div>
        </div>
        <div class="topnav-gradient-line"></div>

        <div class="typed-section">
            <p>FASSET is <span class="typed-text"></span><span class="cursor">&nbsp;</span></p>
        </div>

        <div class="hero-wrap">
            <div class="hero-chart-card">
                <div class="hero-chart-eyebrow">Schedule</div>
                <div class="hero-chart-value">Schedule Calendar</div>
            </div>
        </div>

        <div class="page-content-wrap">
            <div id="calRoot" class="cal-wide-container">
                <div class="cal-toolbar-panel">
                    <div class="cal-toolbar">
                        <form method="get" action="@Url.Action("Calendar", "Schedule")" style="display:flex; gap:10px; align-items:center;">
                            <select name="hostLocation" onchange="this.form.submit()">
                                @foreach (var site in Model.HostLocations)
                                {
                                    <option value="@site" selected="@(site == Model.SelectedHostLocation)">@site</option>
                                }
                            </select>
                            <input type="hidden" name="year" value="@Model.Year" />
                            <input type="hidden" name="month" value="@Model.Month" />
                        </form>

                        <div class="cal-nav">
                            <a class="btn-cal" href="@Url.Action("Calendar", "Schedule", new { hostLocation = Model.SelectedHostLocation, year = prevYear, month = prevMonth })">&larr; Prev</a>
                            <div class="cal-title">@monthNames[Model.Month - 1] @Model.Year</div>
                            <a class="btn-cal" href="@Url.Action("Calendar", "Schedule", new { hostLocation = Model.SelectedHostLocation, year = nextYear, month = nextMonth })">Next &rarr;</a>
                        </div>

                        <div class="view-toggle">
                            <button type="button" id="viewMonthBtn" class="view-toggle-btn active">Month</button>
                            <button type="button" id="viewAgendaBtn" class="view-toggle-btn">Day</button>
                        </div>

                        <button type="button" id="openLoginModalBtn" class="btn-cal" style="background:#38BDF8; color:#0B1220; border-color:#38BDF8; font-weight:700;">
                            Edit
                        </button>
                    </div>
                </div>

                <div id="monthView">
                    <div class="cal-dow-row">
                        @foreach (var dow in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
                        {
                            <div class="cal-dow">@dow</div>
                        }
                    </div>

                    @foreach (var week in weeks)
                    {
                        <div class="cal-week-row">
                            @foreach (var day in week)
                            {
                                if (day == 0)
                                {
                                    <div class="cal-cell empty"></div>
                                }
                                else
                                {
                                    var thisDate = new DateTime(Model.Year, Model.Month, day);
                                    List<FASSET.eCheckIn_v1.Models.ScheduleModel> dayEntries;
                                    Model.EntriesByDate.TryGetValue(thisDate, out dayEntries);

                                    <div class="cal-cell">
                                        <div class="cal-daynum">
                                            <span><span class="cal-daynum-dow">@thisDate.ToString("ddd")</span>@day</span>
                                        </div>
                                        <div class="cal-entry-list">
                                            @if (dayEntries != null)
                                            {
                                                foreach (var entry in dayEntries.OrderBy(e => e.SeatSlot))
                                                {
                                                    var cssClass = entry.IsPublicHoliday ? "holiday" : (entry.IsVacant ? "vacant" : "person");
                                                    var label = entry.IsPublicHoliday
                                                        ? "Public Holiday"
                                                        : (entry.IsVacant ? ("S" + entry.SeatSlot + ": Vacant") : ("S" + entry.SeatSlot + ": " + entry.EmployeeNameRaw));

                                                    <a class="cal-entry @cssClass"
                                                       href="@Url.Action("Edit", "Schedule", new { id = entry.Id, hostLocation = Model.SelectedHostLocation, year = Model.Year, month = Model.Month })"
                                                       title="@label">@label</a>
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>

                <div id="agendaView" class="agenda-view">
                    <div class="day-nav-card">
                        <div class="day-nav-header">
                            <button type="button" id="dayPrevBtn" class="day-nav-btn" aria-label="Previous day">&lsaquo;</button>
                            <div class="agenda-day-header day-nav-title">
                                <span class="agenda-daynum" id="dayNumLabel"></span>
                                <span class="agenda-daymeta" id="dayMetaLabel"></span>
                            </div>
                            <button type="button" id="dayNextBtn" class="day-nav-btn" aria-label="Next day">&rsaquo;</button>
                        </div>
                        <div id="dayEntriesWrap"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script id="scheduleDataJson" type="application/json">@Html.Raw(scheduleJson)</script>

    <script>
        function openSidebar() {
            document.getElementById('sidebar').classList.add('open');
            document.getElementById('sidebarBackdrop').classList.add('show');
        }
        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarBackdrop').classList.remove('show');
        }

        function toggleSidebarPin(e) {
            e.stopPropagation();
            var sidebar = document.querySelector('.sidebar');
            var isPinned = sidebar.classList.toggle('pinned');
            localStorage.setItem('sidebarPinned', isPinned ? '1' : '0');
        }
        (function () {
            if (localStorage.getItem('sidebarPinned') === '1') {
                var sb = document.querySelector('.sidebar');
                if (sb) { sb.classList.add('pinned'); }
            }
        })();

        const typedTextSpan = document.querySelector(".typed-text");
        const cursorSpan = document.querySelector(".cursor");
        const textArray = [
            "e-CheckIn",
            "striving for excellence through hard work",
            "working with honesty and integrity",
            "making a difference",
            "valuing people",
            "innovation"
        ];
        const typingDelay = 60;
        const erasingDelay = 30;
        const newTextDelay = 2500;
        let textArrayIndex = 0;
        let charIndex = 0;

        function type() {
            if (charIndex < textArray[textArrayIndex].length) {
                if (!cursorSpan.classList.contains("typing")) cursorSpan.classList.add("typing");
                typedTextSpan.textContent += textArray[textArrayIndex].charAt(charIndex);
                charIndex++;
                setTimeout(type, typingDelay);
            } else {
                cursorSpan.classList.remove("typing");
                setTimeout(erase, newTextDelay);
            }
        }

        function erase() {
            if (charIndex > 0) {
                if (!cursorSpan.classList.contains("typing")) cursorSpan.classList.add("typing");
                typedTextSpan.textContent = textArray[textArrayIndex].substring(0, charIndex - 1);
                charIndex--;
                setTimeout(erase, erasingDelay);
            } else {
                cursorSpan.classList.remove("typing");
                textArrayIndex++;
                if (textArrayIndex >= textArray.length) textArrayIndex = 0;
                setTimeout(type, typingDelay + 1100);
            }
        }

        if (textArray.length && typedTextSpan && cursorSpan) {
            setTimeout(type, newTextDelay + 250);
        }

        $(function () {
            // ---- Single-day view (mobile: always; desktop: when "Day" is active) ----
            var scheduleData = JSON.parse(document.getElementById('scheduleDataJson').textContent);
            var dayIndex = @defaultDayIndex;
            if (dayIndex < 0 || dayIndex >= scheduleData.length) { dayIndex = 0; }

            function renderDay(idx) {
                var d = scheduleData[idx];
                $('#dayNumLabel').text(d.day);
                $('#dayMetaLabel').text(d.dow);

                var $wrap = $('#dayEntriesWrap').empty();
                if (!d.entries.length) {
                    $('<div class="agenda-empty"></div>').text('No schedule entries for this day.').appendTo($wrap);
                } else {
                    d.entries.forEach(function (e) {
                        $('<a class="agenda-entry"></a>')
                            .addClass(e.cls)
                            .attr('href', e.url)
                            .append($('<span class="agenda-entry-title"></span>').text(e.title))
                            .append($('<span class="agenda-entry-badge"></span>').text(e.badge))
                            .appendTo($wrap);
                    });
                }

                $('#dayPrevBtn').prop('disabled', idx === 0);
                $('#dayNextBtn').prop('disabled', idx === scheduleData.length - 1);
            }

            $('#dayPrevBtn').on('click', function () {
                if (dayIndex > 0) { dayIndex--; renderDay(dayIndex); }
            });

            $('#dayNextBtn').on('click', function () {
                if (dayIndex < scheduleData.length - 1) { dayIndex++; renderDay(dayIndex); }
            });

            renderDay(dayIndex);

            $('#viewMonthBtn').on('click', function () {
                $('#calRoot').removeClass('mode-agenda');
                $('#viewMonthBtn').addClass('active');
                $('#viewAgendaBtn').removeClass('active');
            });

            $('#viewAgendaBtn').on('click', function () {
                $('#calRoot').addClass('mode-agenda');
                $('#viewAgendaBtn').addClass('active');
                $('#viewMonthBtn').removeClass('active');
            });

            // Previously opened a shared login modal from _Layout.cshtml -
            // that layout is not used on this page (self-contained, to
            // match the app's shared theme), so this navigates directly.
            // If Schedule/Edit has an [Authorize] attribute, ASP.NET's own
            // login redirect still protects it.
            $('#openLoginModalBtn').on('click', function () {
                window.location.href = '@Url.Action("Edit", "Schedule", new { hostLocation = Model.SelectedHostLocation })';
            });
        });
    </script>
</body>
</html>
