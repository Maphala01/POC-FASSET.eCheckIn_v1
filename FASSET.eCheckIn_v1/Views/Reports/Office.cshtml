                    </div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-card-top">
                        <div>
                            <div class="kpi-eyebrow">Working hours</div>
                            <div class="kpi-title">Check-In Distribution by Hour</div>
                        </div>
                        <div class="gear-wrap">
                            <div class="kpi-gear" onclick="toggleGearMenu('gearMenuHour', event)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z" /></svg></div>
                            <div class="gear-menu" id="gearMenuHour">
                                <button type="button" onclick="openHourModal(); closeAllGearMenus();">View details</button>
                            </div>
                        </div>
                    </div>
                    <div class="kpi-range-toggle" id="hourRangeToggle">
                        <button type="button" class="kpi-range-btn active" data-range="7">7 days</button>
                        <button type="button" class="kpi-range-btn" data-range="15">15 days</button>
                        <button type="button" class="kpi-range-btn" data-range="30">30 days</button>
                    </div>
                    <canvas id="chartExecHour"></canvas>
                    <div class="kpi-footer">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" stroke-linecap="round" /></svg>
                        Just updated &middot; <span class="kpi-footer-time" id="kpiUpdatedTimeHour">-</span> &middot; expected start at <span id="expectedStartLabel">09:00</span>
                    </div>
                </div>
            </div>
        </div>

        <div id="loadingNote" class="loading-note">Loading&hellip;</div>

        <div class="bottom-grid">
            <div class="bottom-card">
                <div class="bottom-card-header-row">
                    <div>
                        <div class="bottom-card-eyebrow">Today</div>
                        <h2>Recent Check-Ins</h2>
                    </div>
                    <div class="gear-wrap">
                        <div class="kpi-gear" onclick="toggleGearMenu('gearMenuRecent', event)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z" /></svg></div>
                        <div class="gear-menu" id="gearMenuRecent">
                            <button type="button" onclick="openLateVsOnTimeModal(); closeAllGearMenus();">View all check-ins</button>
                            <button type="button" onclick="loadReport(); closeAllGearMenus();">Refresh</button>
                        </div>
                    </div>
                </div>
                <ul class="checkin-list" id="recentCheckinsList">
                    <li><span class="checkin-meta">No data loaded yet.</span></li>
                </ul>
            </div>
            <div class="bottom-card stats-table">
                <div class="bottom-card-header-row">
                    <div>
                        <div class="bottom-card-eyebrow">This period</div>
                        <h2>Employee Attendance</h2>
                    </div>
                    <div class="gear-wrap">
                        <div class="kpi-gear" onclick="toggleGearMenu('gearMenuStats', event)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z" /></svg></div>
                        <div class="gear-menu" id="gearMenuStats">
                            <button type="button" onclick="openEmployeeAttendanceModal(); closeAllGearMenus();">View all employees</button>
                        </div>
                    </div>
                </div>
                <table>
                    <thead>
                        <tr><th>Name</th><th>Department</th><th>Rate</th></tr>
                    </thead>
                    <tbody id="statsTableBody"></tbody>
                </table>
            </div>
        </div>

        <div class="footer-space"></div>
    </div>

    <div id="tableModalBackdrop" class="modal-backdrop" onclick="if (event.target === this) closeTableModal();">
        <div class="modal-box">
            <div class="modal-box-header">
                <h3 id="tableModalTitle">Details</h3>
                <button type="button" class="modal-close-btn" onclick="closeTableModal()">&times;</button>
            </div>
            <div class="modal-box-body">
                <table>
                    <thead id="tableModalHead"></thead>
                    <tbody id="tableModalBody"></tbody>
                </table>
            </div>
            <div class="modal-box-footer">
                <button type="button" class="modal-page-btn" id="modalPrevBtn" onclick="modalChangePage(-1)">Previous</button>
                <span class="modal-page-info" id="modalPageInfo">Page 1 of 1</span>
                <button type="button" class="modal-page-btn" id="modalNextBtn" onclick="modalChangePage(1)">Next</button>
            </div>
        </div>
    </div>

    <script>
        var OFFICE_NAME = @Html.Raw(Json.Encode(officeName));

        function openSidebar() {
            document.getElementById('sidebar').classList.add('open');
            document.getElementById('sidebarBackdrop').classList.add('show');
        }
        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarBackdrop').classList.remove('show');
        }

        function toggleGearMenu(id, evt) {
            evt.stopPropagation();
            var menu = document.getElementById(id);
            var isOpen = menu.classList.contains('open');
            closeAllGearMenus();
            if (!isOpen) menu.classList.add('open');
        }
        function closeAllGearMenus() {
            document.querySelectorAll('.gear-menu').forEach(function (m) { m.classList.remove('open'); });
        }
        document.addEventListener('click', closeAllGearMenus);

        var charts = {};
        var lastReportData = null;
        // Location is fixed to this office - there's no location toggle on
        // this page because the page itself IS the location filter.
        var currentFilters = { start: null, end: null, department: '', location: OFFICE_NAME, lateAfter: '09:00' };

        var modalState = { rows: [], columns: [], pageSize: 10, page: 1 };

        function openTableModal(title, columns, rows) {
            rows = rows || [];
            modalState = { rows: rows, columns: columns, pageSize: 10, page: 1 };
            document.getElementById('tableModalTitle').textContent = title + ' (' + rows.length + ')';
            var head = document.getElementById('tableModalHead');
            head.innerHTML = '<tr>' + columns.map(function (c) { return '<th>' + c.label + '</th>'; }).join('') + '</tr>';
            renderModalPage();
            document.getElementById('tableModalBackdrop').classList.add('show');
        }

        function renderModalPage() {
            var start = (modalState.page - 1) * modalState.pageSize;
            var pageRows = modalState.rows.slice(start, start + modalState.pageSize);
            var body = document.getElementById('tableModalBody');
            body.innerHTML = '';
            pageRows.forEach(function (r) {
                var tr = document.createElement('tr');
                tr.innerHTML = modalState.columns.map(function (c) { return '<td>' + c.render(r) + '</td>'; }).join('');
                body.appendChild(tr);
            });
            var totalPages = Math.max(1, Math.ceil(modalState.rows.length / modalState.pageSize));
            document.getElementById('modalPageInfo').textContent = 'Page ' + modalState.page + ' of ' + totalPages;
            document.getElementById('modalPrevBtn').disabled = modalState.page <= 1;
            document.getElementById('modalNextBtn').disabled = modalState.page >= totalPages;
        }

        function modalChangePage(delta) {
            var totalPages = Math.max(1, Math.ceil(modalState.rows.length / modalState.pageSize));
            modalState.page = Math.min(totalPages, Math.max(1, modalState.page + delta));
            renderModalPage();
        }

        function closeTableModal() {
            document.getElementById('tableModalBackdrop').classList.remove('show');
        }

        function openWeekModal() {
            if (!lastReportData) return;
            openTableModal('Check-ins by Week', [
                { label: 'Week', render: function (r) { return r.label; } },
                { label: 'Expected', render: function (r) { return r.expected !== undefined && r.expected !== null ? r.expected : '-'; } },
                { label: 'Actual', render: function (r) { return r.count; } }
            ], lastReportData.byWeek);
        }

        function filterBusinessHours(items, startHour, endHour) {
            startHour = startHour === undefined ? 6 : startHour;
            endHour = endHour === undefined ? 16 : endHour;
            return (items || []).filter(function (d) {
                var hourPart = parseInt((d.label || '').split(':')[0], 10);
                return !isNaN(hourPart) && hourPart >= startHour && hourPart <= endHour;
            });
        }

        function openHourModal() {
            if (!lastReportData) return;
            openTableModal('Check-ins by 15-Minute Interval', [
                { label: 'Time', render: function (r) { return r.label; } },
                { label: 'Check-ins', render: function (r) { return r.count; } }
            ], filterBusinessHours(lastReportData.byQuarterHour));
        }

        function openLateVsOnTimeModal() {
            if (!lastReportData) return;
            openTableModal('Recent Check-ins', [
                { label: 'Employee', render: function (r) { return r.employeeName; } },
                { label: 'Department', render: function (r) { return r.departmentName; } },
                { label: 'Time', render: function (r) { return r.time; } },
                { label: 'Status', render: function (r) { return r.isLate ? 'Late' : 'On time'; } }
            ], lastReportData.checkInDetails);
        }

        function openEmployeeAttendanceModal() {
            if (!lastReportData) return;
            openTableModal('Employee Attendance', [
                { label: 'Employee', render: function (r) { return r.employeeName; } },
                { label: 'Expected', render: function (r) { return r.expectedDays; } },
                { label: 'Actual', render: function (r) { return r.actualDays; } },
                { label: 'Rate', render: function (r) { return r.ratePercent === null ? 'Not scheduled' : r.ratePercent + '%'; } }
            ], lastReportData.employeeAttendance);
        }

        function exportToExcel() {
            var url = '@Url.Action("ExportExcel", "Reports")'
                + '?start=' + encodeURIComponent(currentFilters.start)
                + '&end=' + encodeURIComponent(currentFilters.end)
                + '&department=' + encodeURIComponent(currentFilters.department)
                + '&location=' + encodeURIComponent(currentFilters.location)
                + '&lateAfter=' + encodeURIComponent(currentFilters.lateAfter);
            window.location.href = url;
        }

        function todayStr() { return new Date().toISOString().slice(0, 10); }
        function daysAgoStr(n) {
            var d = new Date();
            d.setDate(d.getDate() - n);
            return d.toISOString().slice(0, 10);
        }
        function toLocalDateStr(d) {
            var y = d.getFullYear();
            var m = String(d.getMonth() + 1).padStart(2, '0');
            var day = String(d.getDate()).padStart(2, '0');
            return y + '-' + m + '-' + day;
        }

        function destroyChart(id) { if (charts[id]) { charts[id].destroy(); } }

        var sharedTooltip = {
            enabled: true,
            backgroundColor: '#ffffff',
            titleColor: '#23303d',
            bodyColor: '#23303d',
            borderColor: '#e6ebf1',
            borderWidth: 1,
            cornerRadius: 8,
            padding: 10,
            displayColors: true,
            boxPadding: 4,
            titleFont: { weight: '700', size: 12 },
            bodyFont: { size: 12 },
            callbacks: {
                label: function (ctx) { return ' ' + (ctx.dataset.label || 'Data') + ': ' + ctx.formattedValue; }
            }
        };

        function renderBarChart(canvasId, labels, data, color) {
            destroyChart(canvasId);
            var ctx = document.getElementById(canvasId).getContext('2d');
            charts[canvasId] = new Chart(ctx, {
                type: 'bar',
                data: { labels: labels, datasets: [{ label: 'Data', data: data, backgroundColor: color || '#16a3d1', borderRadius: 4 }] },
                options: {
                    responsive: true,
                    interaction: { mode: 'index', intersect: false },
                    plugins: { legend: { display: false }, tooltip: sharedTooltip }
                }
            });
        }

        function renderLineChart(canvasId, labels, data, colorHex) {
            destroyChart(canvasId);
            var ctx = document.getElementById(canvasId).getContext('2d');
            var gradient = ctx.createLinearGradient(0, 0, 0, 220);
            gradient.addColorStop(0, colorHex + '66');
            gradient.addColorStop(1, colorHex + '05');
            charts[canvasId] = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Data', data: data, borderColor: colorHex, backgroundColor: gradient,
                        fill: true, tension: 0.4, pointRadius: 3, pointHoverRadius: 6,
                        pointBackgroundColor: colorHex, pointBorderColor: '#fff', pointBorderWidth: 1.5, borderWidth: 2.5
                    }]
                },
                options: {
                    responsive: true,
                    interaction: { mode: 'index', intersect: false },
                    plugins: { legend: { display: false }, tooltip: sharedTooltip },
                    scales: { y: { beginAtZero: true } }
                }
            });
        }

        function renderHeroChart(labels, data) {
            destroyChart('heroTrendChart');
            var ctx = document.getElementById('heroTrendChart').getContext('2d');
            var gradient = ctx.createLinearGradient(0, 0, 0, 200);
            gradient.addColorStop(0, 'rgba(255,255,255,0.25)');
            gradient.addColorStop(1, 'rgba(255,255,255,0)');
            charts['heroTrendChart'] = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Data', data: data, borderColor: '#fff', backgroundColor: gradient,
                        fill: true, tension: 0.4, pointRadius: 4, pointHoverRadius: 7,
                        pointBackgroundColor: '#fff', pointBorderColor: '#1b3f6e', pointBorderWidth: 2, borderWidth: 2.5
                    }]
                },
                options: {
                    responsive: true,
                    interaction: { mode: 'index', intersect: false },
                    plugins: { legend: { display: false }, tooltip: sharedTooltip },
                    scales: {
                        x: { ticks: { color: 'rgba(255,255,255,0.7)' }, grid: { color: 'rgba(255,255,255,0.08)' } },
                        y: { ticks: { color: 'rgba(255,255,255,0.7)' }, grid: { color: 'rgba(255,255,255,0.08)' }, beginAtZero: true }
                    }
                }
            });
        }

        function renderHourChartWithMarker(data) {
            var el = document.getElementById('expectedStartLabel');
            if (el) { el.textContent = currentFilters.lateAfter; }
            destroyChart('chartExecHour');
            var businessHours = filterBusinessHours(data.byHour);
            var labels = businessHours.map(function (d) { return d.label; });
            var values = businessHours.map(function (d) { return d.count; });

            var markerIndex = labels.indexOf(currentFilters.lateAfter);
            if (markerIndex === -1) {
                var hourPart = currentFilters.lateAfter.split(':')[0];
                markerIndex = labels.findIndex(function (l) { return l.indexOf(hourPart + ':') === 0; });
            }

            var ctx = document.getElementById('chartExecHour').getContext('2d');
            var markerPlugin = {
                id: 'expectedStartMarker',
                afterDraw: function (chart) {
                    if (markerIndex < 0) return;
                    var xScale = chart.scales.x, yScale = chart.scales.y;
                    var x = xScale.getPixelForValue(markerIndex);
                    var c = chart.ctx;
                    c.save();
                    c.beginPath();
                    c.setLineDash([4, 4]);
                    c.strokeStyle = '#e07b39';
                    c.lineWidth = 2;
                    c.moveTo(x, yScale.top);
                    c.lineTo(x, yScale.bottom);
                    c.stroke();
                    c.restore();
                }
            };

            charts['chartExecHour'] = new Chart(ctx, {
                type: 'bar',
                data: { labels: labels, datasets: [{ label: 'Data', data: values, backgroundColor: '#16a3d1', borderRadius: 4 }] },
                options: {
                    responsive: true,
                    interaction: { mode: 'index', intersect: false },
                    plugins: { legend: { display: false }, tooltip: sharedTooltip }
                },
                plugins: [markerPlugin]
            });
        }

        function getTotalHeadcount(d) {
            return (d.attendanceRateByDepartment || []).reduce(function (sum, r) { return sum + r.headcount; }, 0);
        }

        function setDeltaText(elId, current, previous, mode) {
            var el = document.getElementById(elId);
            if (previous === null || previous === undefined || isNaN(previous)) {
                el.textContent = '\u2014';
                el.className = 'exec-kpi-delta';
                return;
            }
            var diff = current - previous;
            var pct = previous !== 0 ? (diff / previous * 100) : (current > 0 ? 100 : 0);
            var arrow = diff > 0 ? '\u2191' : (diff < 0 ? '\u2193' : '\u2192');
            var text = mode === 'points'
                ? (arrow + ' ' + Math.abs(diff).toFixed(1) + ' pts vs prev.')
                : mode === 'count'
                    ? (arrow + ' ' + Math.abs(diff) + ' vs prev.')
                    : (arrow + ' ' + Math.abs(pct).toFixed(1) + '% vs prev.');
            el.textContent = text;
            el.className = 'exec-kpi-delta' + (diff < 0 ? ' down' : '');
        }

        function renderExecKpiRow(data) {
            var totalHeadcount = getTotalHeadcount(data);
            var checkedIn = data.summary.uniqueEmployees;
            var checkInRatePct = totalHeadcount > 0 ? (100 * checkedIn / totalHeadcount) : null;
            var onTime = data.lateVsOnTime.onTime;
            var onTimeTotal = data.lateVsOnTime.onTime + data.lateVsOnTime.late;
            var onTimeRatePct = onTimeTotal > 0 ? (100 * onTime / onTimeTotal) : null;
            var notCheckedIn = Math.max(0, totalHeadcount - checkedIn);

            document.getElementById('kpiExpectedToday').textContent = totalHeadcount;
            document.getElementById('kpiCheckedIn').textContent = checkedIn;
            document.getElementById('kpiCheckInRate').textContent = checkInRatePct !== null ? checkInRatePct.toFixed(1) + '%' : '-';
            document.getElementById('kpiOnTime').textContent = onTime;
            document.getElementById('kpiOnTimeDelta').textContent = onTimeRatePct !== null ? onTimeRatePct.toFixed(1) + '% on-time rate' : '-';
            document.getElementById('kpiNotCheckedIn').textContent = notCheckedIn;

            var startD = new Date(currentFilters.start), endD = new Date(currentFilters.end);
            var rangeDays = Math.max(1, Math.round((endD - startD) / 86400000) + 1);
            var prevEnd = new Date(startD); prevEnd.setDate(prevEnd.getDate() - 1);
            var prevStart = new Date(prevEnd); prevStart.setDate(prevStart.getDate() - (rangeDays - 1));

            var prevUrl = '@Url.Action("Data", "Reports")'
                + '?start=' + encodeURIComponent(toLocalDateStr(prevStart))
                + '&end=' + encodeURIComponent(toLocalDateStr(prevEnd))
                + '&department=' + encodeURIComponent(currentFilters.department)
                + '&location=' + encodeURIComponent(currentFilters.location)
                + '&lateAfter=' + encodeURIComponent(currentFilters.lateAfter);

            fetch(prevUrl).then(function (res) { return res.json(); }).then(function (prevData) {
                var prevHeadcount = getTotalHeadcount(prevData);
                var prevCheckedIn = prevData.summary.uniqueEmployees;
                var prevRatePct = prevHeadcount > 0 ? (100 * prevCheckedIn / prevHeadcount) : null;
                setDeltaText('kpiExpectedTodayDelta', totalHeadcount, prevHeadcount, 'count');
                setDeltaText('kpiCheckedInDelta', checkedIn, prevCheckedIn, 'percent');
                if (checkInRatePct !== null && prevRatePct !== null) {
                    setDeltaText('kpiCheckInRateDelta', checkInRatePct, prevRatePct, 'points');
                } else {
                    document.getElementById('kpiCheckInRateDelta').textContent = '\u2014';
                }
            }).catch(function () {
                ['kpiExpectedTodayDelta', 'kpiCheckedInDelta', 'kpiCheckInRateDelta'].forEach(function (id) {
                    document.getElementById(id).textContent = '\u2014';
                });
            });
        }

        function fillTable(bodyId, rows, rowRenderer) {
            var body = document.getElementById(bodyId);
            body.innerHTML = '';
            rows.forEach(function (r) {
                var tr = document.createElement('tr');
                tr.innerHTML = rowRenderer(r);
                body.appendChild(tr);
            });
        }

        function fillRecentCheckins(rows) {
            var list = document.getElementById('recentCheckinsList');
            list.innerHTML = '';
            var recent = (rows || []).slice(-5).reverse();
            if (recent.length === 0) {
                list.innerHTML = '<li><span class="checkin-meta">No check-ins in this range.</span></li>';
                return;
            }
            recent.forEach(function (r) {
                var li = document.createElement('li');
                li.innerHTML =
                    '<span class="checkin-status-dot ' + (r.isLate ? 'late' : 'on-time') + '"></span>' +
                    '<span><span class="checkin-name">' + r.employeeName + '</span><br/><span class="checkin-meta">' + r.departmentName + '</span></span>' +
                    '<span class="checkin-time">' + r.time + '</span>';
                list.appendChild(li);
            });
        }

        function dailyBucketsFromCheckins(details, startStr, endStr) {
            var start = new Date(startStr), end = new Date(endStr);
            var labels = [], counts = {};
            for (var d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
                var key = toLocalDateStr(d);
                labels.push(key);
                counts[key] = 0;
            }
            var anyDated = false;
            (details || []).forEach(function (r) {
                var rd = new Date(r.time);
                if (isNaN(rd.getTime())) return;
                anyDated = true;
                var key = toLocalDateStr(rd);
                if (counts.hasOwnProperty(key)) counts[key]++;
            });
            return { labels: labels, values: labels.map(function (l) { return counts[l]; }), anyDated: anyDated };
        }

        function fetchDataForDays(days, callback) {
            var end = new Date();
            var start = new Date();
            start.setDate(end.getDate() - (days - 1));
            var startStr = toLocalDateStr(start), endStr = toLocalDateStr(end);
            var url = '@Url.Action("Data", "Reports")'
                + '?start=' + encodeURIComponent(startStr)
                + '&end=' + encodeURIComponent(endStr)
                + '&department=' + encodeURIComponent(currentFilters.department)
                + '&location=' + encodeURIComponent(currentFilters.location)
                + '&lateAfter=' + encodeURIComponent(currentFilters.lateAfter);
            fetch(url).then(function (res) { return res.json(); }).then(function (rangeData) {
                rangeData.checkInDetails = rangeData.checkInDetails || [];
                rangeData.byQuarterHour = rangeData.byQuarterHour || rangeData.byHour || [];
                callback(rangeData, startStr, endStr);
            }).catch(function (err) { console.error('Could not load range data', err); });
        }

        function onTrendRangeSelect(days) {
            fetchDataForDays(days, function (rangeData, startStr, endStr) {
                if (days <= 15) {
                    var b = dailyBucketsFromCheckins(rangeData.checkInDetails, startStr, endStr);
                    if (b.anyDated) { renderLineChart('chartExecWeekly', b.labels, b.values, '#ff5449'); return; }
                }
                renderLineChart('chartExecWeekly',
                    rangeData.byWeek.map(function (d) { return d.label; }),
                    rangeData.byWeek.map(function (d) { return d.count; }), '#ff5449');
            });
        }

        function onHourRangeSelect(days) {
            fetchDataForDays(days, function (rangeData) { renderHourChartWithMarker(rangeData); });
        }

        function wireRangeToggle(toggleId, onSelect, footerTimeId) {
            var el = document.getElementById(toggleId);
            if (!el) return;
            el.addEventListener('click', function (e) {
                var btn = e.target.closest('.kpi-range-btn');
                if (!btn) return;
                el.querySelectorAll('.kpi-range-btn').forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');
                var days = parseInt(btn.getAttribute('data-range'), 10);
                onSelect(days);
                if (footerTimeId) {
                    var t = document.getElementById(footerTimeId);
                    if (t) t.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                }
            });
        }

        wireRangeToggle('trendRangeToggle', onTrendRangeSelect, 'kpiUpdatedTimeWeekly');
        wireRangeToggle('hourRangeToggle', onHourRangeSelect, 'kpiUpdatedTimeHour');

        function loadReport() {
            var loadingNote = document.getElementById('loadingNote');
            loadingNote.style.display = 'block';

            var url = '@Url.Action("Data", "Reports")'
                + '?start=' + encodeURIComponent(currentFilters.start)
                + '&end=' + encodeURIComponent(currentFilters.end)
                + '&department=' + encodeURIComponent(currentFilters.department)
                + '&location=' + encodeURIComponent(currentFilters.location)
                + '&lateAfter=' + encodeURIComponent(currentFilters.lateAfter);

            fetch(url).then(function (res) { return res.json(); }).then(function (data) {
                loadingNote.style.display = 'none';
                data.byQuarterHour = data.byQuarterHour || data.byHour || [];
                data.checkInDetails = data.checkInDetails || [];
                lastReportData = data;

                document.getElementById('heroTotalValue').textContent = data.summary.totalCheckIns + ' check-ins';
                renderHeroChart(data.byWeek.map(function (d) { return d.label; }), data.byWeek.map(function (d) { return d.count; }));

                var updatedTimeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                document.getElementById('kpiUpdatedTimeWeekly').textContent = updatedTimeStr;
                document.getElementById('kpiUpdatedTimeHour').textContent = updatedTimeStr;

                renderExecKpiRow(data);
                renderLineChart('chartExecWeekly', data.byWeek.map(function (d) { return d.label; }), data.byWeek.map(function (d) { return d.count; }), '#ff5449');
                renderHourChartWithMarker(data);

                fillRecentCheckins(data.checkInDetails);
                fillTable('statsTableBody', data.employeeAttendance.slice(0, 7), function (r) {
                    return '<td>' + r.employeeName + '</td><td>' + (r.departmentName || '-') + '</td><td>' + (r.ratePercent === null ? 'Not scheduled' : r.ratePercent + '%') + '</td>';
                });
            }).catch(function (err) {
                loadingNote.style.display = 'none';
                console.error('Failed to load office report data:', err);
                alert('Could not load report data for @shortLabel(officeName). Check the browser console for details.');
            });
        }

        currentFilters.start = daysAgoStr(30);
        currentFilters.end = todayStr();
        loadReport();

        const typedTextSpan = document.querySelector(".typed-text");
        const cursorSpan = document.querySelector(".cursor");
        const textArray = [
            "e-CheckIn",
            "striving for excellence through hard work",
            "working with honesty and integrity",
            "making a difference",
            "valuing people",
            "innovation"
        ];
        const typingDelay = 60;
        const erasingDelay = 30;
        const newTextDelay = 2500;
        let textArrayIndex = 0;
        let charIndex = 0;

        function type() {
            if (charIndex < textArray[textArrayIndex].length) {
                if (!cursorSpan.classList.contains("typing")) cursorSpan.classList.add("typing");
                typedTextSpan.textContent += textArray[textArrayIndex].charAt(charIndex);
                charIndex++;
                setTimeout(type, typingDelay);
            } else {
                cursorSpan.classList.remove("typing");
                setTimeout(erase, newTextDelay);
            }
        }

        function erase() {
            if (charIndex > 0) {
                if (!cursorSpan.classList.contains("typing")) cursorSpan.classList.add("typing");
                typedTextSpan.textContent = textArray[textArrayIndex].substring(0, charIndex - 1);
                charIndex--;
                setTimeout(erase, erasingDelay);
            } else {
                cursorSpan.classList.remove("typing");
                textArrayIndex++;
                if (textArrayIndex >= textArray.length) textArrayIndex = 0;
                setTimeout(type, typingDelay + 1100);
            }
        }

        if (textArray.length && typedTextSpan && cursorSpan) {
            setTimeout(type, newTextDelay + 250);
        }

        function toggleSidebarPin(e) {
            e.stopPropagation();
            var sidebar = document.querySelector('.sidebar');
            var isPinned = sidebar.classList.toggle('pinned');
            localStorage.setItem('sidebarPinned', isPinned ? '1' : '0');
        }
        (function () {
            if (localStorage.getItem('sidebarPinned') === '1') {
                var sb = document.querySelector('.sidebar');
                if (sb) { sb.classList.add('pinned'); }
            }
        })();
    </script>
</body>
</html>
