@{
    Layout = null;
    var officeName = ViewBag.OfficeName as string ?? "Office";
    var offices = new[] { "Bank SETA", "FoodBev", "Tehwane South TVET College - Centurion Campus" };
    var officeShortLabels = new Dictionary<string, string>
{
        { "Bank SETA", "Bank SETA" },
        { "FoodBev", "FoodBev" },
        { "Tehwane South TVET College - Centurion Campus", "Centurion Campus" }
    };
    Func<string, string> shortLabel = o => officeShortLabels.ContainsKey(o) ? officeShortLabels[o] : o;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>FASSET&reg; - @shortLabel(officeName) Office</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <style>
        @@import url('https://fonts.googleapis.com/css?family=Montserrat');

        .sidebar-pin-btn {
            background: rgba(255,255,255,0.12);
            border: none;
            color: rgba(255,255,255,0.85);
            cursor: pointer;
            padding: 6px;
            border-radius: 6px;
            flex-shrink: 0;
            margin-left: auto;
            opacity: 0;
            transition: opacity 0.15s ease, color 0.15s ease, background-color 0.15s ease;
        }

        .sidebar:hover .sidebar-pin-btn {
            opacity: 1;
        }

        .sidebar-pin-btn:hover {
            background: rgba(255,255,255,0.15);
            color: #fff;
        }

        .sidebar-pin-btn svg {
            width: 18px;
            height: 18px;
            display: block;
            transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        /* Pinned = the pin is "pushed in", tilted like a real thumbtack.
           Unpinned = upright. */
        .sidebar.pinned .sidebar-pin-btn svg {
            transform: rotate(45deg);
        }

        .sidebar-pin-btn:active svg {
            transform: scale(0.82);
        }

        .sidebar.pinned .sidebar-pin-btn:active svg {
            transform: rotate(45deg) scale(0.82);
        }

        .sidebar.pinned .sidebar-pin-btn {
            color: #f2b705;
            opacity: 1;
        }

        .sidebar.pinned {
            width: 260px !important;
        }

            .sidebar.pinned .sidebar-brand-text,
            .sidebar.pinned .sidebar-section-label {
                opacity: 1;
            }

        .main-content {
            transition: margin-left 0.2s ease;
        }

        .sidebar.pinned ~ .main-content {
            margin-left: 260px;
        }


        /* ============================================================
           Shared design system - identical to the main Reports
           dashboard (sidebar, hero card, KPI cards, gear menus, chart
           card styling) so this page feels like part of the same app
           rather than a bolted-on extra. See Reports/Index.cshtml for
           the canonical copy of these rules if the two drift apart.
           ============================================================ */
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif;
            color: #23303d;
            background-color: #eef1f6;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 60px;
            overflow: hidden;
            white-space: nowrap;
            background: linear-gradient(180deg, #1b3f6e 0%, #16345c 55%, #12294a 100%);
            color: #fff;
            display: flex;
            flex-direction: column;
            z-index: 1000;
            transition: transform 0.2s ease, width 0.2s ease;
        }

        @@media (min-width: 993px) {
            .sidebar:hover {
                width: 260px;
            }
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 26px 14px;
        }

        .sidebar-logo {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            flex-shrink: 0;
            object-fit: contain;
        }

        .sidebar-brand-text {
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.08em;
            opacity: 0;
            white-space: nowrap;
            transition: opacity 0.15s ease;
        }

        .sidebar:hover .sidebar-brand-text {
            opacity: 1;
        }

        .sidebar-divider {
            height: 1px;
            background: rgba(255,255,255,0.18);
            margin: 4px 24px 14px;
        }

        .sidebar-nav {
            flex: 1;
            padding: 0 14px;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .sidebar-section-label {
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 0.09em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.45);
            padding: 16px 14px 6px;
            opacity: 0;
            white-space: nowrap;
            transition: opacity 0.15s ease;
        }

        .sidebar:hover .sidebar-section-label {
            opacity: 1;
        }

        .sidebar-section-label:first-child {
            padding-top: 4px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 14px;
            border-radius: 4px;
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 600;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            margin-bottom: 2px;
            white-space: nowrap;
            transition: background-color 0.15s ease;
        }

            .sidebar-link svg {
                width: 18px;
                height: 18px;
                flex-shrink: 0;
                opacity: 0.9;
            }

            .sidebar-link:hover {
                background: rgba(255,255,255,0.1);
            }

            .sidebar-link.active {
                background: rgba(255,255,255,0.16);
                color: #fff;
            }

        .sidebar-footer {
            padding: 18px;
        }

        .sidebar-export-btn {
            width: 100%;
            background: rgba(255,255,255,0.16);
            border: 1px solid rgba(255,255,255,0.3);
            color: #fff;
            border-radius: 8px;
            padding: 11px;
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background-color 0.15s ease;
        }

            .sidebar-export-btn:hover {
                background: rgba(255,255,255,0.26);
            }

        .sidebar-toggle-btn {
            display: none;
            background: #fff;
            border: 1px solid #d7dde3;
            border-radius: 8px;
            width: 38px;
            height: 38px;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            margin-right: 14px;
            flex-shrink: 0;
        }

        .sidebar-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.4);
            z-index: 999;
        }

        @@media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
            }

                .sidebar.open {
                    transform: translateX(0);
                    width: 260px;
                }

            .sidebar-toggle-btn {
                display: flex;
            }

            .sidebar-backdrop.show {
                display: block;
            }

            .main-content {
                margin-left: 0 !important;
            }
        }

        .main-content {
            margin-left: 60px;
        }

        .topnav {
            background: #fff;
            padding: 14px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .topnav-left {
            display: flex;
            align-items: center;
        }

        .topnav-gradient-line {
            height: 3px;
            width: 100%;
            background: linear-gradient(90deg, #ff5449, #f2b705, #16a3d1, #2e9e4a, #ff5449);
            background-size: 300% 100%;
            animation: titleUnderlineShift 4s linear infinite;
        }

        @@keyframes titleUnderlineShift {
            0% {
                background-position: 0% 50%;
            }

            100% {
                background-position: 300% 50%;
            }
        }

        .topnav-title {
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #8792a3;
        }

            .topnav-title a {
                color: #8792a3;
                text-decoration: none;
            }

                .topnav-title a:hover {
                    color: #1b3f6e;
                }

        .topnav-icon-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #f2f4f8;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: #556;
            flex-shrink: 0;
        }

            .topnav-icon-btn:hover {
                background: #e8ecf2;
            }

            .topnav-icon-btn svg {
                width: 16px;
                height: 16px;
            }

        .office-picker {
            margin: 22px 30px 0;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

            .office-picker a {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 8px 14px;
                border-radius: 999px;
                border: 1px solid #dde3ea;
                background: #fff;
                color: #445;
                text-decoration: none;
                font-size: 12.5px;
                font-weight: 600;
            }

                .office-picker a svg {
                    width: 13px;
                    height: 13px;
                }

                .office-picker a.active {
                    background: #ff5449;
                    border-color: #ff5449;
                    color: #fff;
                }

        .typed-section {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 10px 16px;
            background: #fff;
            border-bottom: 1px solid #e6ebf1;
        }

            .typed-section p {
                font-family: 'Montserrat', sans-serif;
                font-size: 1.05rem;
                font-weight: bold;
                letter-spacing: 0.05rem;
                text-align: center;
                color: #1b3f6e;
                margin: 0;
                line-height: 1.4;
                max-width: 100%;
                overflow-wrap: anywhere;
            }

                .typed-section p span.typed-text {
                    font-weight: normal;
                    color: #ff5449;
                }

                .typed-section p span.cursor {
                    display: inline-block;
                    background-color: #7c8798;
                    margin-left: 0.1rem;
                    width: 3px;
                    animation: tagBlink 1s infinite;
                }

                    .typed-section p span.cursor.typing {
                        animation: none;
                    }

        @@keyframes tagBlink {
            0% {
                background-color: #7c8798;
            }

            49% {
                background-color: #7c8798;
            }

            50% {
                background-color: transparent;
            }

            99% {
                background-color: transparent;
            }

            100% {
                background-color: #7c8798;
            }
        }

        .hero-wrap {
            padding: 0 30px;
        }

        .hero-chart-card {
            background: linear-gradient(120deg, #0f7fa3, #1b3f6e, #21548f, #14647a, #12294a);
            background-size: 300% 300%;
            animation: heroGradientShift 16s ease infinite;
            border-radius: 0;
            padding: 24px 30px 90px 300px;
            margin: 24px -30px 0 -290px;
            width: calc(100% + 320px);
            position: relative;
            overflow: visible;
            box-shadow: 0 10px 30px rgba(18,41,74,0.28);
            z-index: 1;
        }

        @@keyframes heroGradientShift {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        @@media (max-width: 992px) {
            .hero-chart-card {
                margin: 24px -30px 0;
                width: calc(100% + 60px);
                padding-left: 30px;
            }
        }

        .hero-chart-eyebrow {
            color: rgba(255,255,255,0.6);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .hero-chart-value {
            color: #fff;
            font-size: 22px;
            font-weight: 700;
        }

        .hero-gear-wrap {
            position: absolute;
            top: 20px;
            right: 30px;
        }

        .gear-wrap {
            position: relative;
            flex-shrink: 0;
        }

        .hero-gear-btn {
            width: 56px;
            height: 56px;
            border-radius: 12px;
            background: rgba(255,255,255,0.12);
            border: none;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background-color 0.15s ease;
        }

            .hero-gear-btn svg {
                width: 26px;
                height: 26px;
            }

            .hero-gear-btn:hover {
                background: rgba(255,255,255,0.24);
            }

        .hero-chart-card canvas {
            margin-top: 10px;
            max-height: 200px;
        }

        .exec-kpi-row {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 20px;
            margin-top: -70px;
            margin-bottom: 24px;
            position: relative;
            z-index: 2;
        }

        @@media (max-width: 1100px) {
            .exec-kpi-row {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (max-width: 700px) {
            .exec-kpi-row {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .exec-kpi-card {
            background: #fff;
            border: 1px solid #e6ebf1;
            border-radius: 14px;
            box-shadow: 0 8px 24px rgba(20,48,79,0.14);
            padding: 16px 18px;
        }

            .exec-kpi-card.border-gold {
                border-color: #f2b705;
                border-width: 1px 1px 1px 4px;
            }

            .exec-kpi-card.border-teal {
                border-color: #16a3d1;
                border-width: 1px 1px 1px 4px;
            }

            .exec-kpi-card.border-green {
                border-color: #2e9e4a;
                border-width: 1px 1px 1px 4px;
            }

            .exec-kpi-card.border-red {
                border-color: #e05043;
                border-width: 1px 1px 1px 4px;
            }

            .exec-kpi-card .exec-kpi-label {
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.05em;
                text-transform: uppercase;
                color: #99a3b3;
            }

            .exec-kpi-card .exec-kpi-value {
                font-size: 26px;
                font-weight: 700;
                color: #2a3646;
                margin-top: 4px;
            }

            .exec-kpi-card .exec-kpi-delta {
                font-size: 12px;
                font-weight: 600;
                color: #2e9e4a;
                margin-top: 4px;
            }

                .exec-kpi-card .exec-kpi-delta.down {
                    color: #e05043;
                }

                .exec-kpi-card .exec-kpi-delta.warn {
                    color: #e07b39;
                }

        .kpi-range-toggle {
            display: flex;
            gap: 4px;
            background: #f2f4f8;
            border-radius: 8px;
            padding: 3px;
            margin-top: 10px;
            margin-bottom: 4px;
        }

        .kpi-range-btn {
            flex: 1;
            border: none;
            background: transparent;
            color: #556;
            border-radius: 6px;
            padding: 6px 8px;
            font-size: 11.5px;
            font-weight: 500;
            cursor: pointer;
        }

            .kpi-range-btn.active {
                background: #fff;
                color: #ff5449;
                box-shadow: 0 2px 6px rgba(20,48,79,0.15);
            }

        .kpi-card-row {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
            margin-bottom: 28px;
        }

        @@media (max-width: 900px) {
            .kpi-card-row {
                grid-template-columns: 1fr;
            }
        }

        .kpi-card {
            background: #fff;
            border-radius: 14px;
            border: 1px solid #e6ebf1;
            box-shadow: 0 8px 24px rgba(20,48,79,0.14);
            padding: 24px 26px 20px;
            display: flex;
            flex-direction: column;
        }

        .kpi-card-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            position: relative;
        }

        .kpi-eyebrow {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: #99a3b3;
            margin-bottom: 4px;
        }

        .kpi-title {
            font-size: 21px;
            font-weight: 700;
            color: #2a3646;
        }

        .kpi-gear {
            width: 56px;
            height: 56px;
            border-radius: 12px;
            border: 1px solid #e6ebf1;
            background: #fff;
            color: #8792a3;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            cursor: pointer;
            transition: background-color 0.15s ease, color 0.15s ease;
        }

            .kpi-gear:hover {
                background: #f7f9fb;
                color: #1b3f6e;
            }

            .kpi-gear svg {
                width: 26px;
                height: 26px;
            }


        .gear-menu {
            display: none;
            position: absolute;
            top: 110%;
            right: 0;
            background: #fff;
            border-radius: 9px;
            box-shadow: 0 10px 28px rgba(20,48,79,0.22);
            border: 1px solid #e6ebf1;
            min-width: 170px;
            z-index: 60;
            overflow: hidden;
        }

            .gear-menu.open {
                display: block;
            }

            .gear-menu button {
                display: block;
                width: 100%;
                text-align: left;
                background: none;
                border: none;
                padding: 10px 14px;
                font-size: 12.5px;
                color: #445;
                cursor: pointer;
            }

                .gear-menu button:hover {
                    background: #f7f9fb;
                    color: #1b3f6e;
                }

        .kpi-card canvas {
            margin-top: 10px;
            max-height: 220px;
        }

        .kpi-footer {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: #99a3b3;
            margin-top: auto;
            padding-top: 12px;
            border-top: 1px solid #f0f2f5;
        }

            .kpi-footer .kpi-footer-time {
                color: #7c8798;
                font-weight: 600;
            }

            .kpi-footer svg {
                width: 13px;
                height: 13px;
                flex-shrink: 0;
            }

        .bottom-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            margin: 0 30px 28px;
        }

        @@media (max-width: 900px) {
            .bottom-grid {
                grid-template-columns: 1fr;
            }
        }

        .bottom-card {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 4px 14px rgba(20,48,79,0.06);
            border: 1px solid #e6ebf1;
            padding: 20px 22px;
        }

        .bottom-card-header-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            position: relative;
        }

        .bottom-card-eyebrow {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: #99a3b3;
            margin-bottom: 2px;
        }

        .bottom-card h2 {
            font-size: 18px;
            font-weight: 700;
            margin: 0 0 14px 0;
            color: #2a3646;
        }

        .checkin-list {
            list-style: none;
            margin: 0;
            padding: 0;
            max-height: 340px;
            overflow-y: auto;
        }

            .checkin-list li {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 10px 0;
                border-bottom: 1px solid #f0f2f5;
            }

                .checkin-list li:last-child {
                    border-bottom: none;
                }

        .checkin-status-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            flex-shrink: 0;
        }

            .checkin-status-dot.on-time {
                background: #2e9e4a;
            }

            .checkin-status-dot.late {
                background: #e05043;
            }

        .checkin-list .checkin-name {
            font-size: 13.5px;
            font-weight: 600;
            color: #2a3646;
        }

        .checkin-list .checkin-meta {
            font-size: 12px;
            color: #99a3b3;
        }

        .checkin-list .checkin-time {
            margin-left: auto;
            font-size: 12.5px;
            font-weight: 600;
            color: #556;
            white-space: nowrap;
        }

        .stats-table table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        .stats-table th {
            text-align: left;
            padding: 8px 8px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: #ff5449;
            border-bottom: 2px solid #f0f2f5;
        }

        .stats-table td {
            padding: 10px 8px;
            border-bottom: 1px solid #f0f2f5;
            color: #445;
        }

        .stats-table tbody tr:hover {
            background-color: #f7f9fb;
        }

        .modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 40, 74, 0.6);
            z-index: 999999;
            align-items: center;
            justify-content: center;
        }

            .modal-backdrop.show {
                display: flex;
            }

        .modal-box {
            background: #fff;
            border-radius: 14px;
            max-width: 640px;
            width: 92%;
            max-height: 80vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 20px 50px rgba(0,0,0,0.35);
        }

        .modal-box-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 22px;
            border-bottom: 1px solid #eee;
        }

            .modal-box-header h3 {
                margin: 0;
                font-size: 16px;
                font-weight: 600;
                color: #1b3f6e;
            }

        .modal-close-btn {
            border: none;
            background: none;
            font-size: 20px;
            line-height: 1;
            color: #889;
            cursor: pointer;
            padding: 4px 8px;
        }

        .modal-box-body {
            padding: 12px 22px;
            overflow-y: auto;
        }

            .modal-box-body table {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
            }

            .modal-box-body th, .modal-box-body td {
                text-align: left;
                padding: 9px 8px;
            }

            .modal-box-body th {
                color: #7c8798;
                font-weight: 600;
                font-size: 11.5px;
                letter-spacing: 0.03em;
                text-transform: uppercase;
                background: #f7f9fc;
            }

            .modal-box-body td {
                border-bottom: 1px solid #f0f2f5;
            }

        .modal-box-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 22px;
            border-top: 1px solid #eee;
        }

        .modal-page-btn {
            border: 1px solid #dde3ea;
            background: #f7f9fb;
            color: #445;
            border-radius: 7px;
            padding: 7px 15px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
        }

            .modal-page-btn:disabled {
                opacity: 0.4;
                cursor: not-allowed;
            }

        .modal-page-info {
            font-size: 13px;
            color: #667;
        }

        .loading-note {
            font-size: 13px;
            color: #8792a3;
            margin: 16px 30px 0;
            display: none;
        }

        .footer-space {
            height: 30px;
        }
    </style>
</head>
<body>

