        <div class="sidebar-footer">
            <button type="button" class="sidebar-export-btn" onclick="exportToExcel()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 19h16" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Export to Excel
            </button>
        </div>
    </div>

    <div class="main-content">
        <div class="topnav">
            <div class="topnav-left">
                <button type="button" class="sidebar-toggle-btn" onclick="openSidebar()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1b3f6e" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" /></svg>
                </button>
                <div class="topnav-title">FASSET&reg; CHECK-IN REPORTS</div>
            </div>
            <div class="topnav-right">
                <button type="button" class="topnav-icon-btn" title="Refresh" onclick="loadReport()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0115.3-6.4L21 8M3 12a9 9 0 0015.3 6.4L21 16M21 3v5h-5M3 21v-5h5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
            </div>
        </div>
        <div class="topnav-gradient-line"></div>

        <div class="typed-section">
            <p>FASSET is <span class="typed-text"></span><span class="cursor">&nbsp;</span></p>
        </div>

        <div class="hero-wrap">
            <div class="hero-chart-card">
                <div class="hero-chart-eyebrow">This period</div>
                <div class="hero-chart-value" id="heroTotalValue">-</div>
                <div class="hero-gear-wrap">
                    <button type="button" class="hero-gear-btn" onclick="toggleGearMenu('heroGearMenu', event)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z" /></svg>
                    </button>
                    <div class="gear-menu" id="heroGearMenu">
                        <button type="button" onclick="loadReport(); closeAllGearMenus();">Refresh data</button>
                        <button type="button" onclick="exportToExcel();">Export to Excel</button>
                    </div>
                </div>
                <canvas id="heroTrendChart" height="80"></canvas>
            </div>

            <div class="exec-kpi-row">
                <div class="exec-kpi-card border-gold">
                    <div class="exec-kpi-label">Expected Today</div>
                    <div class="exec-kpi-value" id="kpiExpectedToday">-</div>
                    <div class="exec-kpi-delta" id="kpiExpectedTodayDelta">-</div>
                </div>
                <div class="exec-kpi-card border-teal">
                    <div class="exec-kpi-label">Checked In</div>
                    <div class="exec-kpi-value" id="kpiCheckedIn">-</div>
                    <div class="exec-kpi-delta" id="kpiCheckedInDelta">-</div>
                </div>
                <div class="exec-kpi-card border-green">
                    <div class="exec-kpi-label">Check-In Rate</div>
                    <div class="exec-kpi-value" id="kpiCheckInRate">-</div>
                    <div class="exec-kpi-delta" id="kpiCheckInRateDelta">-</div>
                </div>
                <div class="exec-kpi-card border-green">
                    <div class="exec-kpi-label">On Time</div>
                    <div class="exec-kpi-value" id="kpiOnTime">-</div>
                    <div class="exec-kpi-delta" id="kpiOnTimeDelta">-</div>
                </div>
                <div class="exec-kpi-card border-red">
                    <div class="exec-kpi-label">Not Checked In</div>
                    <div class="exec-kpi-value" id="kpiNotCheckedIn">-</div>
                    <div class="exec-kpi-delta warn">Needs review</div>
                </div>
            </div>

            <div class="kpi-card-row">
                <div class="kpi-card">
                    <div class="kpi-card-top">
                        <div>
                            <div class="kpi-eyebrow">This period</div>
                            <div class="kpi-title">Check-In Trend</div>
