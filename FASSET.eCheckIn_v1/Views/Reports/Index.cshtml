@{
    Layout = null;
    var departments = ViewBag.Departments as List<string>;
    var locations = ViewBag.Locations as List<string>;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>FASSET&reg; - Check-In Reports</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif;
            color: #23303d;
            background-color: #eef2f7;
            background-image: radial-gradient(circle at 8% 0%, rgba(27,63,110,0.10) 0%, rgba(27,63,110,0) 45%), radial-gradient(circle at 95% 15%, rgba(242,196,12,0.10) 0%, rgba(242,196,12,0) 40%), linear-gradient(180deg, #eaf0f7 0%, #eef2f7 400px, #eef2f7 100%);
            background-attachment: fixed;
        }

        header {
            background: linear-gradient(120deg, #12294a 0%, #1b3f6e 55%, #21548f 100%);
            color: #fff;
            padding: 22px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            box-shadow: 0 6px 18px rgba(18,41,74,0.28);
            position: relative;
        }

            header::after {
                content: '';
                position: absolute;
                left: 0;
                right: 0;
                bottom: 0;
                height: 6px;
                background: linear-gradient(90deg, transparent 0%, #f2c40c 50%, transparent 100%);
                background-size: 200% 100%;
                animation: headerShimmer 3.5s linear infinite;
            }

        @@keyframes headerShimmer {
            0% {
                background-position: 200% 0;
            }

            100% {
                background-position: -200% 0;
            }
        }

        header h1 {
            font-size: 21px;
            font-weight: 600;
            margin: 0;
            letter-spacing: 0.01em;
        }

        header .subtitle {
            font-size: 12.5px;
            opacity: 0.8;
            margin-top: 2px;
        }

        #exportBtn {
            background-color: #fff;
            border: 1px solid #1b3f6e;
            color: #1b3f6e;
            border-radius: 7px;
            padding: 9px 18px 9px 14px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            transition: background-color 0.15s ease;
        }

            #exportBtn:hover {
                background-color: #eef2f8;
            }

        .filters {
            background: #fff;
            margin: 22px 28px 18px 28px;
            padding: 18px 22px;
            border-radius: 14px;
            border: 2px solid #c7d3e0;
            box-shadow: 0 4px 16px rgba(20,48,79,0.07);
            display: flex;
            gap: 18px;
            flex-wrap: wrap;
            align-items: flex-end;
        }

        .filter-field label {
            display: block;
            font-size: 11.5px;
            font-weight: 600;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            color: #8792a3;
            margin-bottom: 6px;
        }

        .filter-field input, .filter-field select {
            padding: 9px 11px;
            border: 1px solid #d7dde3;
            border-radius: 7px;
            font-size: 14px;
            background: #fbfcfd;
            transition: border-color 0.15s ease;
        }

            .filter-field input:focus, .filter-field select:focus {
                outline: none;
                border-color: #1b3f6e;
            }

        #applyBtn {
            background: linear-gradient(135deg, #1b3f6e, #163458);
            color: #fff;
            border: none;
            border-radius: 7px;
            padding: 10px 22px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            box-shadow: 0 3px 10px rgba(27,63,110,0.3);
            transition: box-shadow 0.15s ease, transform 0.15s ease;
        }

            #applyBtn:hover {
                box-shadow: 0 5px 14px rgba(27,63,110,0.4);
                transform: translateY(-1px);
            }

        .quick-view-row {
            display: flex;
            gap: 3px;
            background: #f0f3f7;
            border-radius: 8px;
            padding: 3px;
        }

        .quick-view-btn {
            border: none;
            background: transparent;
            color: #556;
            border-radius: 6px;
            padding: 7px 13px;
            font-size: 12.5px;
            font-weight: 500;
            cursor: pointer;
            white-space: nowrap;
            transition: background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
        }

            .quick-view-btn:hover {
                background: #e4e9ef;
            }

            .quick-view-btn.active {
                background: #fff;
                color: #1b3f6e;
                box-shadow: 0 2px 6px rgba(20,48,79,0.18);
            }

        .summary-cards {
            display: flex;
            gap: 16px;
            margin: 0 28px 20px 28px;
            flex-wrap: wrap;
        }

        .card {
            border-radius: 14px;
            border: 1px solid #e6ebf1;
            box-shadow: 0 4px 14px rgba(20,48,79,0.06);
            padding: 20px 22px;
            flex: 1;
            min-width: 170px;
            text-align: center;
            position: relative;
            overflow: hidden;
            transition: box-shadow 0.15s ease, transform 0.15s ease;
            background: #f5f7fa;
        }

            .card.accent-navy {
                background: linear-gradient(135deg, #21548f, #12294a);
                border-color: #12294a;
            }

            .card.accent-teal {
                background: linear-gradient(135deg, #16a3d1, #0c6483);
                border-color: #0c6483;
            }

            .card.accent-green {
                background: linear-gradient(135deg, #3fbb5d, #237a37);
                border-color: #237a37;
            }

            .card.accent-red {
                background: linear-gradient(135deg, #e05043, #a13022);
                border-color: #a13022;
            }

            .card:hover {
                box-shadow: 0 10px 24px rgba(20,48,79,0.22);
                transform: translateY(-2px);
            }

            .card .icon {
                width: 30px;
                height: 30px;
                margin: 0 auto 8px auto;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 8px;
                background: rgba(255,255,255,0.18);
            }

                .card .icon svg {
                    width: 16px;
                    height: 16px;
                }

            .card .value {
                font-size: 30px;
                font-weight: 700;
                letter-spacing: -0.02em;
                color: #2a3646;
            }

            .card.accent-navy .value,
            .card.accent-teal .value,
            .card.accent-green .value,
            .card.accent-red .value {
                color: #fff;
            }

            .card .label {
                font-size: 11.5px;
                font-weight: 600;
                letter-spacing: 0.05em;
                text-transform: uppercase;
                color: #8792a3;
                margin-top: 6px;
            }

            .card.accent-navy .label,
            .card.accent-teal .label,
            .card.accent-green .label,
            .card.accent-red .label {
                color: rgba(255,255,255,0.8);
            }

        .category-bar {
            background: #fff;
            border-radius: 14px;
            border: 2px solid #c7d3e0;
            box-shadow: 0 4px 14px rgba(20,48,79,0.06);
            margin: 0 28px 20px 28px;
            padding: 16px 20px;
        }

            .category-bar .category-bar-label {
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.05em;
                text-transform: uppercase;
                color: #99a3b3;
                margin-bottom: 10px;
            }

        .pill-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .pill {
            border: 1px solid #dde3ea;
            background: #f7f9fb;
            color: #445;
            border-radius: 999px;
            padding: 9px 18px;
            font-size: 13.5px;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
        }

            .pill:hover {
                background: #eef2f6;
            }

            .pill.active {
                background: #1b3f6e;
                color: #fff;
                border-color: #1b3f6e;
                box-shadow: 0 3px 10px rgba(27,63,110,0.3);
            }

        .report-section {
            display: none;
        }

            .report-section.visible {
                display: block;
            }

        .chart-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
            gap: 20px;
            margin: 0 28px 8px 28px;
        }

        .chart-card {
            background: #fff;
            border-radius: 14px;
            border: 2px solid #d7dde3;
            box-shadow: 0 4px 14px rgba(20,48,79,0.06);
            padding: 18px 20px;
            transition: box-shadow 0.15s ease;
        }

            .chart-card:hover {
                box-shadow: 0 8px 22px rgba(20,48,79,0.1);
            }

            .chart-card h2 {
                font-size: 14.5px;
                font-weight: 600;
                margin: 0 0 14px 0;
                color: #2a3646;
            }

            .chart-card canvas {
                max-height: 280px;
            }

        [data-category="executive"] .chart-card {
            border-color: #1b3f6e;
        }

        [data-category="attendance"] .chart-card {
            border-color: #0f7fa3;
        }

        [data-category="department"] .chart-card {
            border-color: #2e9e4a;
        }

        .table-card table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        .table-card th, .table-card td {
            text-align: left;
            padding: 8px 10px;
        }

        .table-card th {
            color: #7c8798;
            font-weight: 600;
            font-size: 11.5px;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            background: #f7f9fc;
        }

        .table-card td {
            border-bottom: 1px solid #f0f2f5;
        }

        .table-card tbody tr:hover {
            background-color: #f7f9fb;
        }

        .card-header-row {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin-bottom: 14px;
        }

            .card-header-row h2 {
                margin: 0;
            }

        .view-all-link {
            font-size: 12.5px;
            color: #1b3f6e;
            text-decoration: none;
            font-weight: 600;
            white-space: nowrap;
        }

            .view-all-link:hover {
                text-decoration: underline;
            }

        .modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 40, 74, 0.6);
            z-index: 999999;
            align-items: center;
            justify-content: center;
        }

            .modal-backdrop.show {
                display: flex;
            }

        .modal-box {
            background: #fff;
            border-radius: 14px;
            max-width: 640px;
            width: 92%;
            max-height: 80vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 20px 50px rgba(0,0,0,0.35);
        }

        .modal-box-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 22px;
            border-bottom: 1px solid #eee;
        }

            .modal-box-header h3 {
                margin: 0;
                font-size: 16px;
                font-weight: 600;
                color: #1b3f6e;
            }

        .modal-close-btn {
            border: none;
            background: none;
            font-size: 20px;
            line-height: 1;
            color: #889;
            cursor: pointer;
            padding: 4px 8px;
        }

            .modal-close-btn:hover {
                color: #23303d;
            }

        .modal-box-body {
            padding: 12px 22px;
            overflow-y: auto;
        }

            .modal-box-body table {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
            }

            .modal-box-body th, .modal-box-body td {
                text-align: left;
                padding: 9px 8px;
            }

            .modal-box-body th {
                color: #7c8798;
                font-weight: 600;
                font-size: 11.5px;
                letter-spacing: 0.03em;
                text-transform: uppercase;
                background: #f7f9fc;
            }

            .modal-box-body td {
                border-bottom: 1px solid #f0f2f5;
            }

            .modal-box-body tbody tr:hover {
                background-color: #f7f9fb;
            }

        .modal-box-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 22px;
            border-top: 1px solid #eee;
        }

        .modal-page-btn {
            border: 1px solid #dde3ea;
            background: #f7f9fb;
            color: #445;
            border-radius: 7px;
            padding: 7px 15px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
        }

            .modal-page-btn:hover:not(:disabled) {
                background: #eef2f6;
            }

            .modal-page-btn:disabled {
                opacity: 0.4;
                cursor: not-allowed;
            }

        .modal-page-info {
            font-size: 13px;
            color: #667;
        }

        .loading-note {
            font-size: 13px;
            color: #8792a3;
            margin: 0 28px 12px 28px;
            display: none;
        }

        .footer-space {
            height: 30px;
        }

        /* ---- FASSET typed tagline — matches this page's light theme
           (navy text, gold accent from the header shimmer) rather than
           the white-on-blue version used on the Registration screen. ---- */
        @@import url('https://fonts.googleapis.com/css?family=Montserrat');

        .typed-section {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 4px 16px 40px;
        }

            .typed-section p {
                font-family: 'Montserrat', sans-serif;
                font-size: 1.4rem;
                font-weight: bold;
                letter-spacing: 0.05rem;
                text-align: center;
                color: #1b3f6e;
                margin: 0;
                line-height: 1.4;
                max-width: 100%;
                overflow-wrap: anywhere;
            }

                .typed-section p span.typed-text {
                    font-weight: normal;
                    color: #f2c40c;
                }

                .typed-section p span.cursor {
                    display: inline-block;
                    background-color: #7c8798;
                    margin-left: 0.1rem;
                    width: 3px;
                    animation: tagBlink 1s infinite;
                }

                    .typed-section p span.cursor.typing {
                        animation: none;
                    }

        @@keyframes tagBlink {
            0% {
                background-color: #7c8798;
            }

            49% {
                background-color: #7c8798;
            }

            50% {
                background-color: transparent;
            }

            99% {
                background-color: transparent;
            }

            100% {
                background-color: #7c8798;
            }
        }

        @@media (max-width: 600px) {
            .typed-section p {
                font-size: 1.05rem;
            }
        }
    </style>
</head>
<body>
    <header>
        <div>
            <h1>FASSET&reg; Check-In Reports</h1>
            <div class="subtitle">Attendance &amp; workforce breakdown</div>
        </div>
    </header>

    <div class="filters">
        <div class="filter-field">
            <label for="startDate">From</label>
            <input type="date" id="startDate" />
        </div>
        <div class="filter-field">
            <label for="endDate">To</label>
            <input type="date" id="endDate" />
        </div>
        <div class="filter-field">
            <label for="departmentSelect">Department</label>
            <select id="departmentSelect">
                <option value="">All departments</option>
                @if (departments != null)
                {
                    foreach (var dept in departments)
                    {
                        <option value="@dept">@dept</option>
                    }
                }
            </select>
        </div>
        <div class="filter-field">
            <label for="locationSelect">Location</label>
            <select id="locationSelect">
                <option value="">All locations</option>
                @if (locations != null)
                {
                    foreach (var loc in locations)
                    {
                        <option value="@loc">@loc</option>
                    }
                }
            </select>
        </div>
        <div class="filter-field">
            <label for="lateAfter">Late after</label>
            <input type="time" id="lateAfter" value="09:00" />
        </div>
        <div class="filter-field">
            <label>Quick view</label>
            <div class="quick-view-row">
                <button type="button" class="quick-view-btn" onclick="applyQuickView('today', event)">Today</button>
                <button type="button" class="quick-view-btn" onclick="applyQuickView('week', event)">This week</button>
                <button type="button" class="quick-view-btn" onclick="applyQuickView('month', event)">This month</button>
                <button type="button" class="quick-view-btn active" onclick="applyQuickView('30', event)">Last 30 days</button>
            </div>
        </div>
        <button id="applyBtn" onclick="loadReport()">Apply</button>
        <button type="button" id="exportBtn" onclick="exportToExcel()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 19h16" stroke="#1b3f6e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Export to Excel
        </button>
    </div>

    <div id="loadingNote" class="loading-note">Loading&hellip;</div>

    <div class="summary-cards">
        <div class="card accent-navy">
            <div class="icon"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 12l2 2 4-4m5 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
            <div class="value" id="totalCheckIns">-</div>
            <div class="label">Total check-ins</div>
        </div>
        <div class="card accent-teal">
            <div class="icon"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="18" height="18" rx="2" stroke="#fff" stroke-width="2" /><path d="M3 10h18M8 2v4M16 2v4" stroke="#fff" stroke-width="2" stroke-linecap="round" /></svg></div>
            <div class="value" id="dateRangeDays">-</div>
            <div class="label">Days in range</div>
        </div>
    </div>

    <div class="category-bar">
        <div class="category-bar-label">Report categories</div>
        <div class="pill-row">
            <button class="pill active" data-target="executive" onclick="showCategory('executive')">Executive Overview</button>
            <button class="pill" data-target="attendance" onclick="showCategory('attendance')">Attendance Detail</button>
            <button class="pill" data-target="department" onclick="showCategory('department')">Department View</button>
        </div>
    </div>

    <div class="report-section visible" data-category="executive">
        <div class="summary-cards">
            <div class="card accent-navy">
                <div class="value" id="execUniqueEmployees">-</div>
                <div class="label">Unique employees</div>
            </div>
            <div class="card accent-green">
                <div class="value" id="execOnTimePercent">-</div>
                <div class="label">On time</div>
            </div>
            <div class="card accent-red">
                <div class="value" id="execLatePercent">-</div>
                <div class="label">Late</div>
            </div>
            <div class="card accent-teal">
                <div class="value" id="execDepartmentsActive">-</div>
                <div class="label">Departments active</div>
            </div>
        </div>
        <div class="chart-grid">
            <div class="chart-card">
                <h2>Weekly trend</h2>
                <canvas id="chartExecWeekly"></canvas>
            </div>
            <div class="chart-card">
                <h2>Monthly trend</h2>
                <canvas id="chartExecMonthly"></canvas>
            </div>
            <div class="chart-card">
                <h2>Department distribution</h2>
                <canvas id="chartExecDepartment"></canvas>
            </div>
            <div class="chart-card">
                <h2>Check-ins by hour</h2>
                <canvas id="chartExecHour"></canvas>
            </div>
        </div>
    </div>

    <div class="report-section" data-category="attendance">
        <div class="summary-cards">
            <div class="card accent-navy">
                <div class="value" id="attUniqueEmployees">-</div>
                <div class="label">Unique employees</div>
            </div>
            <div class="card accent-green">
                <div class="value" id="attOnTimeCount">-</div>
                <div class="label">On time</div>
            </div>
            <div class="card accent-red">
                <div class="value" id="attLateCount">-</div>
                <div class="label">Late arrivals</div>
            </div>
            <div class="card accent-teal">
                <div class="value" id="averageArrivalTimeValue">-</div>
                <div class="label">Average arrival time</div>
            </div>
        </div>
        <div class="chart-grid">
            <div class="chart-card">
                <div class="card-header-row">
                    <h2>Check-ins by day of week</h2>
                    <a href="#" id="dayOfWeekViewAll" class="view-all-link" onclick="openDayOfWeekModal(); return false;">View all &rarr;</a>
                </div>
                <canvas id="chartByDayOfWeek"></canvas>
            </div>
            <div class="chart-card">
                <div class="card-header-row">
                    <h2>Check-ins by hour of day</h2>
                    <a href="#" id="hourViewAll" class="view-all-link" onclick="openHourModal(); return false;">View all &rarr;</a>
                </div>
                <canvas id="chartByHour"></canvas>
            </div>
            <div class="chart-card">
                <div class="card-header-row">
                    <h2>Check-ins by week</h2>
                    <a href="#" id="weekViewAll" class="view-all-link" onclick="openWeekModal(); return false;">View all &rarr;</a>
                </div>
                <canvas id="chartByWeek"></canvas>
            </div>
            <div class="chart-card">
                <div class="card-header-row">
                    <h2>Late vs. on-time (<span id="lateThresholdLabel">09:00</span>)</h2>
                    <a href="#" id="lateVsOnTimeViewAll" class="view-all-link" onclick="openLateVsOnTimeModal(); return false;">View all &rarr;</a>
                </div>
                <canvas id="chartLateVsOnTime"></canvas>
            </div>
            <div class="chart-card table-card">
                <div class="card-header-row">
                    <h2>Employee Attendance <span style="font-weight:normal;font-size:12px;color:#888;">(vs. schedule)</span></h2>
                    <a href="#" id="employeeAttendanceViewAll" class="view-all-link" onclick="openEmployeeAttendanceModal(); return false;">View all &rarr;</a>
                </div>
                <table>
                    <thead>
                        <tr><th>Employee</th><th>Expected</th><th>Actual</th><th>Rate</th></tr>
                    </thead>
                    <tbody id="employeeAttendanceBody"></tbody>
                </table>
            </div>
            <div class="chart-card table-card">
                <div class="card-header-row">
                    <h2>Check-ins by location</h2>
                    <a href="#" id="locationViewAll" class="view-all-link" onclick="openLocationModal(); return false;">View all &rarr;</a>
                </div>
                <table>
                    <thead>
                        <tr><th>Address</th><th>Check-ins</th><th>Out of Bounds</th></tr>
                    </thead>
                    <tbody id="byLocationBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="report-section" data-category="department">
        <div class="summary-cards">
            <div class="card accent-navy">
                <div class="value" id="deptDepartmentsActive">-</div>
                <div class="label">Departments active</div>
            </div>
            <div class="card accent-teal">
                <div class="value" id="deptTotalHeadcount">-</div>
                <div class="label">Total headcount</div>
            </div>
            <div class="card accent-green">
                <div class="value" id="deptTotalCheckIns">-</div>
                <div class="label">Total check-ins in range</div>
            </div>
            <div class="card accent-navy">
                <div class="value" id="deptOverallRate">-</div>
                <div class="label">Overall attendance rate</div>
            </div>
        </div>
        <div class="chart-grid">
            <div class="chart-card">
                <h2>Check-ins by department</h2>
                <canvas id="chartByDepartment"></canvas>
            </div>
            <div class="chart-card table-card">
                <div class="card-header-row">
                    <h2>Attendance rate by department (% of headcount)</h2>
                    <a href="#" id="attendanceRateViewAll" class="view-all-link" onclick="openAttendanceRateModal(); return false;">View all &rarr;</a>
                </div>
                <table>
                    <thead>
                        <tr><th>Department</th><th>Checked in</th><th>Headcount</th><th>Rate</th></tr>
                    </thead>
                    <tbody id="attendanceRateBody"></tbody>
                </table>
            </div>
            <div class="chart-card">
                <h2>Occupational level distribution</h2>
                <canvas id="chartByOccLevel"></canvas>
            </div>
        </div>
    </div>

    <div class="footer-space"></div>

    <div class="typed-section">
        <p>FASSET is <span class="typed-text"></span><span class="cursor">&nbsp;</span></p>
    </div>

    <div id="tableModalBackdrop" class="modal-backdrop" onclick="if (event.target === this) closeTableModal();">
        <div class="modal-box">
            <div class="modal-box-header">
                <div style="display:flex; align-items:center; gap:10px;">
                    <button type="button" class="modal-page-btn" id="modalBackBtn" onclick="modalGoBack()" style="display:none;">&larr; Back</button>
                    <h3 id="tableModalTitle">Details</h3>
                </div>
                <button type="button" class="modal-close-btn" onclick="closeTableModal()">&times;</button>
            </div>
            <div class="modal-box-body">
                <table>
                    <thead id="tableModalHead"></thead>
                    <tbody id="tableModalBody"></tbody>
                </table>
            </div>
            <div class="modal-box-footer">
                <button type="button" class="modal-page-btn" id="modalPrevBtn" onclick="modalChangePage(-1)">Previous</button>
                <span class="modal-page-info" id="modalPageInfo">Page 1 of 1</span>
                <button type="button" class="modal-page-btn" id="modalNextBtn" onclick="modalChangePage(1)">Next</button>
            </div>
        </div>
    </div>

    <script>
        function showCategory(target) {
            document.querySelectorAll('.pill').forEach(function (p) {
                p.classList.toggle('active', p.getAttribute('data-target') === target);
            });
            document.querySelectorAll('.report-section').forEach(function (s) {
                s.classList.toggle('visible', s.getAttribute('data-category') === target);
            });
            // Charts created while their tab was hidden render into a
            // zero-size canvas - force a resize now that it's visible.
            setTimeout(function () {
                Object.keys(charts).forEach(function (id) {
                    if (charts[id]) { charts[id].resize(); }
                });
            }, 0);
        }

        var charts = {};
        var brandColors = ['#1b3f6e', '#2e9e4a', '#f2b705', '#c0392b', '#7d5ba6', '#0f7fa3', '#e07b39', '#5c6f7d'];
        var lastReportData = null;

        var modalState = { rows: [], columns: [], pageSize: 10, page: 1 };

        function openTableModal(title, columns, rows, backAction) {
            rows = rows || [];
            modalState = { rows: rows, columns: columns, pageSize: 10, page: 1, backAction: backAction || null };
            document.getElementById('tableModalTitle').textContent = title + ' (' + rows.length + ')';

            var backBtn = document.getElementById('modalBackBtn');
            backBtn.style.display = modalState.backAction ? 'inline-block' : 'none';

            var head = document.getElementById('tableModalHead');
            head.innerHTML = '<tr>' + columns.map(function (c) { return '<th>' + c.label + '</th>'; }).join('') + '</tr>';

            renderModalPage();
            document.getElementById('tableModalBackdrop').classList.add('show');
        }

        function renderModalPage() {
            var start = (modalState.page - 1) * modalState.pageSize;
            var pageRows = modalState.rows.slice(start, start + modalState.pageSize);
            var body = document.getElementById('tableModalBody');
            body.innerHTML = '';
            pageRows.forEach(function (r) {
                var tr = document.createElement('tr');
                tr.innerHTML = modalState.columns.map(function (c) { return '<td>' + c.render(r) + '</td>'; }).join('');
                body.appendChild(tr);
            });

            var totalPages = Math.max(1, Math.ceil(modalState.rows.length / modalState.pageSize));
            document.getElementById('modalPageInfo').textContent = 'Page ' + modalState.page + ' of ' + totalPages;
            document.getElementById('modalPrevBtn').disabled = modalState.page <= 1;
            document.getElementById('modalNextBtn').disabled = modalState.page >= totalPages;
        }

        function modalChangePage(delta) {
            var totalPages = Math.max(1, Math.ceil(modalState.rows.length / modalState.pageSize));
            modalState.page = Math.min(totalPages, Math.max(1, modalState.page + delta));
            renderModalPage();
        }

        function closeTableModal() {
            document.getElementById('tableModalBackdrop').classList.remove('show');
        }

        function modalGoBack() {
            if (modalState.backAction) {
                modalState.backAction();
            }
        }

        function openEmployeeAttendanceModal() {
            if (!lastReportData) return;
            openTableModal('Employee Attendance', [
                { label: 'Employee', render: function (r) { return r.employeeName; } },
                { label: 'Expected', render: function (r) { return r.expectedDays; } },
                { label: 'Actual', render: function (r) { return r.actualDays; } },
                { label: 'Rate', render: function (r) { return r.ratePercent === null ? 'Not scheduled' : r.ratePercent + '%'; } }
            ], lastReportData.employeeAttendance);
        }

        function openAttendanceRateModal() {
            if (!lastReportData) return;
            openTableModal('Attendance Rate by Department', [
                { label: 'Department', render: function (r) { return r.label; } },
                { label: 'Checked in', render: function (r) { return r.checkedIn; } },
                { label: 'Headcount', render: function (r) { return r.headcount; } },
                { label: 'Rate', render: function (r) { return r.ratePercent + '%'; } }
            ], lastReportData.attendanceRateByDepartment);
        }

        function openDayOfWeekModal() {
            if (!lastReportData) return;
            openTableModal('Check-ins by Day of Week', [
                { label: 'Day', render: function (r) { return r.label; } },
                { label: 'Expected', render: function (r) { return r.expected; } },
                { label: 'Actual', render: function (r) { return r.count; } }
            ], lastReportData.byDayOfWeek);
        }

        function openHourModal() {
            if (!lastReportData) return;
            openTableModal('Check-ins by 15-Minute Interval', [
                { label: 'Time', render: function (r) { return r.label; } },
                { label: 'Check-ins', render: function (r) { return r.count; } }
            ], lastReportData.byQuarterHour);
        }

        function openWeekModal() {
            if (!lastReportData) return;
            openTableModal('Check-ins by Week', [
                { label: 'Week', render: function (r) { return r.label; } },
                { label: 'Expected', render: function (r) { return r.expected; } },
                { label: 'Actual', render: function (r) { return r.count; } }
            ], lastReportData.byWeek);
        }

        function openLateVsOnTimeModal() {
            if (!lastReportData) return;
            var rows = [
                { status: 'On-time', count: lastReportData.lateVsOnTime.onTime, key: 'onTime' },
                { status: 'Late (after ' + lastReportData.lateVsOnTime.threshold + ')', count: lastReportData.lateVsOnTime.late, key: 'late' }
            ];
            openTableModal('Late vs. On-Time', [
                { label: 'Status', render: function (r) { return r.status; } },
                { label: 'Check-ins', render: function (r) { return r.count; } },
                { label: 'Action', render: function (r) { return '<a href="#" class="view-all-link" onclick="openLateVsOnTimeDetail(\'' + r.key + '\'); return false;">View &rarr;</a>'; } }
            ], rows);
        }

        function openLateVsOnTimeDetail(key) {
            if (!lastReportData) return;
            var filtered = (lastReportData.checkInDetails || []).filter(function (r) {
                return key === 'late' ? r.isLate : !r.isLate;
            });
            var title = key === 'late' ? 'Late Check-ins' : 'On-Time Check-ins';
            openTableModal(title, [
                { label: 'Employee', render: function (r) { return r.employeeName; } },
                { label: 'Department', render: function (r) { return r.departmentName; } },
                { label: 'Location', render: function (r) { return r.location; } },
                { label: 'Time', render: function (r) { return r.time; } }
            ], filtered, openLateVsOnTimeModal);
        }

        function openLocationModal() {
            if (!lastReportData) return;
            openTableModal('Check-ins by Location', [
                { label: 'Address', render: function (r) { return r.label; } },
                { label: 'Check-ins', render: function (r) { return r.count; } },
                { label: 'Out of Bounds', render: function (r) { return r.outOfBounds; } }
            ], lastReportData.byLocation);
        }

        function exportToExcel() {
            var start = document.getElementById('startDate').value;
            var end = document.getElementById('endDate').value;
            var dept = document.getElementById('departmentSelect').value;
            var location = document.getElementById('locationSelect').value;
            var lateAfter = document.getElementById('lateAfter').value;

            // The Excel file (with the logo, colors, native charts, and
            // filterable tables) is now built server-side via EPPlus in
            // Reports/ExportExcel, not in the browser - SheetJS's free tier
            // can't do any of those. Navigating to the URL triggers the
            // file download directly.
            var url = '@Url.Action("ExportExcel", "Reports")'
                + '?start=' + encodeURIComponent(start)
                + '&end=' + encodeURIComponent(end)
                + '&department=' + encodeURIComponent(dept)
                + '&location=' + encodeURIComponent(location)
                + '&lateAfter=' + encodeURIComponent(lateAfter);
            window.location.href = url;
        }

        function todayStr() { return new Date().toISOString().slice(0, 10); }
        function daysAgoStr(n) {
            var d = new Date();
            d.setDate(d.getDate() - n);
            return d.toISOString().slice(0, 10);
        }

        function toLocalDateStr(d) {
            // Avoids the UTC-shift bug toISOString() has near midnight in
            // timezones ahead of UTC (like SAST, UTC+2).
            var y = d.getFullYear();
            var m = String(d.getMonth() + 1).padStart(2, '0');
            var day = String(d.getDate()).padStart(2, '0');
            return y + '-' + m + '-' + day;
        }

        function applyQuickView(range, evt) {
            var today = new Date();
            var start, end = today;

            if (range === 'today') {
                start = today;
            } else if (range === 'week') {
                var diff = (today.getDay() + 6) % 7; // days since Monday
                start = new Date(today);
                start.setDate(today.getDate() - diff);
            } else if (range === 'month') {
                start = new Date(today.getFullYear(), today.getMonth(), 1);
            } else if (range === '30') {
                start = new Date(today);
                start.setDate(today.getDate() - 30);
            }

            document.getElementById('startDate').value = toLocalDateStr(start);
            document.getElementById('endDate').value = toLocalDateStr(end);

            document.querySelectorAll('.quick-view-btn').forEach(function (b) { b.classList.remove('active'); });
            evt.target.classList.add('active');

            loadReport();
        }

        function destroyChart(id) {
            if (charts[id]) { charts[id].destroy(); }
        }

        function renderBarChart(canvasId, labels, data, horizontal) {
            destroyChart(canvasId);
            var ctx = document.getElementById(canvasId).getContext('2d');
            charts[canvasId] = new Chart(ctx, {
                type: 'bar',
                data: { labels: labels, datasets: [{ data: data, backgroundColor: brandColors }] },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    indexAxis: horizontal ? 'y' : 'x'
                }
            });
        }

        function renderDoughnutChart(canvasId, labels, data) {
            destroyChart(canvasId);
            var ctx = document.getElementById(canvasId).getContext('2d');
            charts[canvasId] = new Chart(ctx, {
                type: 'doughnut',
                data: { labels: labels, datasets: [{ data: data, backgroundColor: brandColors }] },
                options: { responsive: true }
            });
        }

        function fillTable(bodyId, rows, rowRenderer) {
            var body = document.getElementById(bodyId);
            body.innerHTML = '';
            rows.forEach(function (r) {
                var tr = document.createElement('tr');
                tr.innerHTML = rowRenderer(r);
                body.appendChild(tr);
            });
        }

        function loadReport() {
            var start = document.getElementById('startDate').value;
            var end = document.getElementById('endDate').value;
            var dept = document.getElementById('departmentSelect').value;
            var location = document.getElementById('locationSelect').value;
            var lateAfter = document.getElementById('lateAfter').value;
            var loadingNote = document.getElementById('loadingNote');

            loadingNote.style.display = 'block';

            var url = '@Url.Action("Data", "Reports")'
                + '?start=' + encodeURIComponent(start)
                + '&end=' + encodeURIComponent(end)
                + '&department=' + encodeURIComponent(dept)
                + '&location=' + encodeURIComponent(location)
                + '&lateAfter=' + encodeURIComponent(lateAfter);

            fetch(url)
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    loadingNote.style.display = 'none';

                    // Defensive normalization: if the deployed backend is an
                    // older version missing a field (e.g. byQuarterHour,
                    // checkInDetails, outOfBounds), fill in a safe default
                    // instead of letting one missing field throw partway
                    // through this callback and silently skip everything
                    // after it (which is what caused Department View to show
                    // blank/dashes when this happened before).
                    data.byQuarterHour = data.byQuarterHour || data.byHour || [];
                    data.checkInDetails = data.checkInDetails || [];
                    data.byLocation = (data.byLocation || []).map(function (r) {
                        return { label: r.label, count: r.count, outOfBounds: r.outOfBounds || 'N/A' };
                    });

                    lastReportData = data;

                    document.getElementById('totalCheckIns').textContent = data.summary.totalCheckIns;
                    document.getElementById('dateRangeDays').textContent = data.summary.dateRangeDays;

                    // Executive overview
                    var execTotal = data.lateVsOnTime.onTime + data.lateVsOnTime.late;
                    document.getElementById('execUniqueEmployees').textContent = data.summary.uniqueEmployees;
                    document.getElementById('execDepartmentsActive').textContent = data.byDepartment.length;
                    document.getElementById('execOnTimePercent').textContent = execTotal > 0 ? Math.round(100 * data.lateVsOnTime.onTime / execTotal) + '%' : '-';
                    document.getElementById('execLatePercent').textContent = execTotal > 0 ? Math.round(100 * data.lateVsOnTime.late / execTotal) + '%' : '-';
                    renderBarChart('chartExecWeekly', data.byWeek.map(function (d) { return d.label; }), data.byWeek.map(function (d) { return d.count; }), false);
                    renderBarChart('chartExecMonthly', data.byMonth.map(function (d) { return d.label; }), data.byMonth.map(function (d) { return d.count; }), false);
                    renderBarChart('chartExecDepartment', data.byDepartment.map(function (d) { return d.label; }), data.byDepartment.map(function (d) { return d.count; }), data.byDepartment.length > 6);
                    renderBarChart('chartExecHour', data.byHour.map(function (d) { return d.label; }), data.byHour.map(function (d) { return d.count; }), false);

                    // Attendance detail
                    document.getElementById('attUniqueEmployees').textContent = data.summary.uniqueEmployees;
                    document.getElementById('attOnTimeCount').textContent = data.lateVsOnTime.onTime;
                    document.getElementById('attLateCount').textContent = data.lateVsOnTime.late;
                    document.getElementById('averageArrivalTimeValue').textContent = data.averageArrivalTime;
                    renderBarChart('chartByDayOfWeek', data.byDayOfWeek.map(function (d) { return d.label; }), data.byDayOfWeek.map(function (d) { return d.count; }), false);
                    renderBarChart('chartByHour', data.byHour.map(function (d) { return d.label; }), data.byHour.map(function (d) { return d.count; }), false);
                    renderBarChart('chartByWeek', data.byWeek.map(function (d) { return d.label; }), data.byWeek.map(function (d) { return d.count; }), false);

                    document.getElementById('lateThresholdLabel').textContent = data.lateVsOnTime.threshold;
                    renderDoughnutChart('chartLateVsOnTime', ['On-time', 'Late'], [data.lateVsOnTime.onTime, data.lateVsOnTime.late]);

                    fillTable('employeeAttendanceBody', data.employeeAttendance.slice(0, 5), function (r) {
                        return '<td>' + r.employeeName + '</td><td>' + r.expectedDays + '</td><td>' + r.actualDays + '</td><td>' + (r.ratePercent === null ? 'Not scheduled' : r.ratePercent + '%') + '</td>';
                    });
                    document.getElementById('employeeAttendanceViewAll').innerHTML = 'View all (' + data.employeeAttendance.length + ') &rarr;';
                    document.getElementById('dayOfWeekViewAll').innerHTML = 'View all (' + data.byDayOfWeek.length + ') &rarr;';
                    document.getElementById('hourViewAll').innerHTML = 'View all (' + data.byQuarterHour.length + ') &rarr;';
                    document.getElementById('weekViewAll').innerHTML = 'View all (' + data.byWeek.length + ') &rarr;';
                    document.getElementById('lateVsOnTimeViewAll').innerHTML = 'View all (2) &rarr;';
                    document.getElementById('locationViewAll').innerHTML = 'View all (' + data.byLocation.length + ') &rarr;';

                    fillTable('byLocationBody', data.byLocation.slice(0, 5), function (r) {
                        return '<td>' + r.label + '</td><td>' + r.count + '</td><td>' + r.outOfBounds + '</td>';
                    });

                    // Department view
                    renderBarChart('chartByDepartment', data.byDepartment.map(function (d) { return d.label; }), data.byDepartment.map(function (d) { return d.count; }), data.byDepartment.length > 6);

                    fillTable('attendanceRateBody', data.attendanceRateByDepartment.slice(0, 5), function (r) {
                        return '<td>' + r.label + '</td><td>' + r.checkedIn + '</td><td>' + r.headcount + '</td><td>' + r.ratePercent + '%</td>';
                    });
                    document.getElementById('attendanceRateViewAll').innerHTML = 'View all (' + data.attendanceRateByDepartment.length + ') &rarr;';

                    document.getElementById('deptDepartmentsActive').textContent = data.attendanceRateByDepartment.length;
                    var totalHeadcount = data.attendanceRateByDepartment.reduce(function (sum, r) { return sum + r.headcount; }, 0);
                    var totalCheckedIn = data.attendanceRateByDepartment.reduce(function (sum, r) { return sum + r.checkedIn; }, 0);
                    document.getElementById('deptTotalHeadcount').textContent = totalHeadcount;
                    document.getElementById('deptOverallRate').textContent = totalHeadcount > 0 ? Math.round(100 * totalCheckedIn / totalHeadcount) + '%' : '-';
                    document.getElementById('deptTotalCheckIns').textContent = data.summary.totalCheckIns;

                    // Workforce demographics
                    renderBarChart('chartByOccLevel', data.byOccupationalLevel.map(function (d) { return d.label; }), data.byOccupationalLevel.map(function (d) { return d.count; }), false);
                })
                .catch(function (err) {
                    loadingNote.style.display = 'none';
                    console.error('Failed to load report data:', err);
                    alert('Could not load report data. Check the browser console for details.');
                });
        }

        document.getElementById('startDate').value = daysAgoStr(30);
        document.getElementById('endDate').value = todayStr();
        loadReport();

        // ---- FASSET typed tagline ----
        const typedTextSpan = document.querySelector(".typed-text");
        const cursorSpan = document.querySelector(".cursor");
        const textArray = [
            "e-CheckIn",
            "striving for excellence through hard work",
            "working with honesty and integrity",
            "making a difference",
            "valuing people",
            "innovation"
        ];
        const typingDelay = 60;
        const erasingDelay = 30;
        const newTextDelay = 2500;
        let textArrayIndex = 0;
        let charIndex = 0;

        function type() {
            if (charIndex < textArray[textArrayIndex].length) {
                if (!cursorSpan.classList.contains("typing")) cursorSpan.classList.add("typing");
                typedTextSpan.textContent += textArray[textArrayIndex].charAt(charIndex);
                charIndex++;
                setTimeout(type, typingDelay);
            } else {
                cursorSpan.classList.remove("typing");
                setTimeout(erase, newTextDelay);
            }
        }

        function erase() {
            if (charIndex > 0) {
                if (!cursorSpan.classList.contains("typing")) cursorSpan.classList.add("typing");
                typedTextSpan.textContent = textArray[textArrayIndex].substring(0, charIndex - 1);
                charIndex--;
                setTimeout(erase, erasingDelay);
            } else {
                cursorSpan.classList.remove("typing");
                textArrayIndex++;
                if (textArrayIndex >= textArray.length) textArrayIndex = 0;
                setTimeout(type, typingDelay + 1100);
            }
        }

        if (textArray.length && typedTextSpan && cursorSpan) {
            setTimeout(type, newTextDelay + 250);
        }
    </script>
</body>
</html>
