                <a href="@Url.Action("Office", "Reports", new { name = office })" class="sidebar-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.5-7-11a7 7 0 0114 0c0 4.5-7 11-7 11z" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="10" r="2.5" /></svg>@office</a>
