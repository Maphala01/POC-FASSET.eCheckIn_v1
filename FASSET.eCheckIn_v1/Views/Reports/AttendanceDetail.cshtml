@{
    Layout = null;
    var departments = ViewBag.Departments as List<string>;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>FASSET&reg; - Attendance Detail</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
    <style>
        @@import url('https://fonts.googleapis.com/css?family=Montserrat');

        .sidebar-pin-btn {
            background: rgba(255,255,255,0.12);
            border: none;
            color: rgba(255,255,255,0.85);
            cursor: pointer;
            padding: 6px;
            border-radius: 6px;
            flex-shrink: 0;
            margin-left: auto;
            opacity: 0;
            transition: opacity 0.15s ease, color 0.15s ease, background-color 0.15s ease;
        }

        .sidebar:hover .sidebar-pin-btn {
            opacity: 1;
        }

        .sidebar-pin-btn:hover {
            background: rgba(255,255,255,0.15);
            color: #fff;
        }

        .sidebar-pin-btn svg {
            width: 18px;
            height: 18px;
            display: block;
            transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        /* Pinned = the pin is "pushed in", tilted like a real thumbtack.
           Unpinned = upright. */
        .sidebar.pinned .sidebar-pin-btn svg {
            transform: rotate(45deg);
        }

        .sidebar-pin-btn:active svg {
            transform: scale(0.82);
        }

        .sidebar.pinned .sidebar-pin-btn:active svg {
            transform: rotate(45deg) scale(0.82);
        }

        .sidebar.pinned .sidebar-pin-btn {
            color: #f2b705;
            opacity: 1;
        }

        .sidebar.pinned {
            width: 260px !important;
        }

            .sidebar.pinned .sidebar-brand-text,
            .sidebar.pinned .sidebar-section-label {
                opacity: 1;
            }

        .main-content {
            transition: margin-left 0.2s ease;
        }

        .sidebar.pinned ~ .main-content {
            margin-left: 260px;
        }


        .typed-section {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 10px 16px;
            background: #fff;
            border-bottom: 1px solid #e6ebf1;
        }

            .typed-section p {
                font-family: 'Montserrat', sans-serif;
                font-size: 1.05rem;
                font-weight: bold;
                letter-spacing: 0.05rem;
                text-align: center;
                color: #1b3f6e;
                margin: 0;
                line-height: 1.4;
                max-width: 100%;
                overflow-wrap: anywhere;
            }

                .typed-section p span.typed-text {
                    font-weight: normal;
                    color: #ff5449;
                }

                .typed-section p span.cursor {
                    display: inline-block;
                    background-color: #7c8798;
                    margin-left: 0.1rem;
                    width: 3px;
                    animation: tagBlink 1s infinite;
                }

                    .typed-section p span.cursor.typing {
                        animation: none;
                    }

        @@keyframes tagBlink {
            0% {
                background-color: #7c8798;
            }

            49% {
                background-color: #7c8798;
            }

            50% {
                background-color: transparent;
            }

            99% {
                background-color: transparent;
            }

            100% {
                background-color: #7c8798;
            }
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif;
            color: #23303d;
            background-color: #eef1f6;
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 60px;
            overflow: hidden;
            white-space: nowrap;
            background: linear-gradient(180deg, #1b3f6e 0%, #16345c 55%, #12294a 100%);
            color: #fff;
            display: flex;
            flex-direction: column;
            z-index: 1000;
            transition: width 0.2s ease;
        }

        @@media (min-width: 993px) {
            .sidebar:hover {
                width: 260px;
            }
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 26px 14px;
        }

        .sidebar-logo {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            flex-shrink: 0;
            object-fit: contain;
        }

        .sidebar-brand-text {
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.08em;
            opacity: 0;
            white-space: nowrap;
            transition: opacity 0.15s ease;
        }

        .sidebar:hover .sidebar-brand-text {
            opacity: 1;
        }

        .sidebar-divider {
            height: 1px;
            background: rgba(255,255,255,0.18);
            margin: 4px 24px 14px;
        }

        .sidebar-nav {
            flex: 1;
            padding: 0 14px;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .sidebar-section-label {
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 0.09em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.45);
            padding: 16px 14px 6px;
            opacity: 0;
            white-space: nowrap;
            transition: opacity 0.15s ease;
        }

        .sidebar:hover .sidebar-section-label {
            opacity: 1;
        }

        .sidebar-section-label:first-child {
            padding-top: 4px;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 14px;
            border-radius: 4px;
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 600;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            margin-bottom: 2px;
            white-space: nowrap;
        }

            .sidebar-link svg {
                width: 18px;
                height: 18px;
                flex-shrink: 0;
                opacity: 0.9;
            }

            .sidebar-link:hover {
                background: rgba(255,255,255,0.1);
            }

            .sidebar-link.active {
                background: rgba(255,255,255,0.16);
                color: #fff;
            }

        .main-content {
            margin-left: 60px;
        }

        .topnav {
            background: #fff;
            padding: 14px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .topnav-gradient-line {
            height: 3px;
            width: 100%;
            background: linear-gradient(90deg, #ff5449, #f2b705, #16a3d1, #2e9e4a, #ff5449);
            background-size: 300% 100%;
            animation: titleUnderlineShift 4s linear infinite;
        }

        @@keyframes titleUnderlineShift {
            0% {
                background-position: 0% 50%;
            }

            100% {
                background-position: 300% 50%;
            }
        }

        .topnav-title {
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #8792a3;
        }

            .topnav-title a {
                color: #8792a3;
                text-decoration: none;
            }

                .topnav-title a:hover {
                    color: #1b3f6e;
                }

        .topnav-icon-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #f2f4f8;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: #556;
        }

            .topnav-icon-btn:hover {
                background: #e8ecf2;
            }

            .topnav-icon-btn svg {
                width: 16px;
                height: 16px;
            }

        /* ---- Hero + Row 1 KPIs - identical pattern to the Dashboard ---- */
        .hero-wrap {
            padding: 0 30px;
        }

        .hero-chart-card {
            background: linear-gradient(120deg, #0f7fa3, #1b3f6e, #21548f, #14647a, #12294a);
            background-size: 300% 300%;
            animation: heroGradientShift 16s ease infinite;
            border-radius: 0;
            padding: 24px 30px 90px 300px;
            margin: 24px -30px 0 -290px;
            width: calc(100% + 320px);
            position: relative;
            overflow: visible;
            box-shadow: 0 10px 30px rgba(18,41,74,0.28);
            z-index: 1;
        }

        @@keyframes heroGradientShift {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        @@media (max-width: 992px) {
            .hero-chart-card {
                margin: 24px -30px 0;
                width: calc(100% + 60px);
                padding-left: 30px;
            }
        }

        .hero-chart-eyebrow {
            color: rgba(255,255,255,0.6);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .hero-chart-value {
            color: #fff;
            font-size: 22px;
            font-weight: 700;
        }

        .hero-gear-wrap {
            position: absolute;
            top: 20px;
            right: 30px;
        }

        .hero-gear-btn {
            width: 56px;
            height: 56px;
            border-radius: 12px;
            background: rgba(255,255,255,0.12);
            border: none;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

            .hero-gear-btn svg {
                width: 26px;
                height: 26px;
            }

            .hero-gear-btn:hover {
                background: rgba(255,255,255,0.24);
            }

        .hero-chart-card canvas {
            margin-top: 10px;
            max-height: 200px;
        }

        .exec-kpi-row {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 20px;
            margin-top: -70px;
            margin-bottom: 24px;
            position: relative;
            z-index: 2;
        }

        @@media (max-width: 1100px) {
            .exec-kpi-row {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (max-width: 700px) {
            .exec-kpi-row {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .exec-kpi-card {
            background: #fff;
            border: 1px solid #e6ebf1;
            border-radius: 14px;
            box-shadow: 0 8px 24px rgba(20,48,79,0.14);
            padding: 16px 18px;
        }

            .exec-kpi-card.border-gold {
                border-color: #f2b705;
                border-width: 1px 1px 1px 4px;
            }

            .exec-kpi-card.border-teal {
                border-color: #16a3d1;
                border-width: 1px 1px 1px 4px;
            }

            .exec-kpi-card.border-green {
                border-color: #2e9e4a;
                border-width: 1px 1px 1px 4px;
            }

            .exec-kpi-card.border-red {
                border-color: #e05043;
                border-width: 1px 1px 1px 4px;
            }

            .exec-kpi-card .exec-kpi-label {
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.05em;
                text-transform: uppercase;
                color: #99a3b3;
            }

            .exec-kpi-card .exec-kpi-value {
                font-size: 26px;
                font-weight: 700;
                color: #2a3646;
                margin-top: 4px;
            }

            .exec-kpi-card .exec-kpi-delta {
                font-size: 12px;
                font-weight: 600;
                color: #2e9e4a;
                margin-top: 4px;
            }

                .exec-kpi-card .exec-kpi-delta.down {
                    color: #e05043;
                }

                .exec-kpi-card .exec-kpi-delta.warn {
                    color: #e07b39;
                }

        /* ---- Filters + raw table ---- */
        .attendance-filters {
            background: #fff;
            margin: 0 30px 20px;
            padding: 16px 20px;
            border-radius: 14px;
            border: 1px solid #e6ebf1;
            box-shadow: 0 4px 14px rgba(20,48,79,0.05);
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            align-items: flex-end;
        }

            .attendance-filters .filter-field label {
                display: block;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.03em;
                text-transform: uppercase;
                color: #8792a3;
                margin-bottom: 6px;
            }

            .attendance-filters .filter-field input,
            .attendance-filters .filter-field select {
                padding: 8px 10px;
                border: 1px solid #d7dde3;
                border-radius: 7px;
                font-size: 13px;
                background: #fbfcfd;
            }

                .attendance-filters .filter-field input:focus,
                .attendance-filters .filter-field select:focus {
                    outline: none;
                    border-color: #ff5449;
                }

        #attApplyBtn {
            background: linear-gradient(135deg, #ff7a45, #ff5449);
            color: #fff;
            border: none;
            border-radius: 7px;
            padding: 9px 20px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 3px 10px rgba(255,84,73,0.3);
        }

        #attExportBtn {
            background: #fff;
            border: 1px solid #1b3f6e;
            color: #1b3f6e;
            border-radius: 7px;
            padding: 9px 20px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

            #attExportBtn:hover {
                background: #eef2f8;
            }

        .table-card {
            background: #fff;
            border: 1px solid #e6ebf1;
            border-radius: 14px;
            box-shadow: 0 4px 14px rgba(20,48,79,0.06);
            margin: 0 30px 40px;
            padding: 18px 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13.5px;
        }

        th {
            text-align: left;
            padding: 10px 12px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: #ff5449;
            border-bottom: 2px solid #f0f2f5;
        }

        td {
            padding: 10px 12px;
            border-bottom: 1px solid #f0f2f5;
            color: #445;
        }

        tbody tr:hover {
            background-color: #f7f9fb;
        }

        .attendance-pagination {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 14px;
            margin-top: 6px;
            border-top: 1px solid #f0f2f5;
        }

        .modal-page-btn {
            border: 1px solid #dde3ea;
            background: #f7f9fb;
            color: #445;
            border-radius: 7px;
            padding: 7px 15px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
        }

            .modal-page-btn:disabled {
                opacity: 0.4;
                cursor: not-allowed;
            }

        .modal-page-info {
            font-size: 13px;
            color: #667;
        }

        .loading-note {
            font-size: 13px;
            color: #8792a3;
            margin: 0 30px 12px;
            display: none;
        }

        .footer-space {
            height: 30px;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-brand">
            <img src="~/Content/Small_Fasset.png" class="sidebar-logo" alt="FASSET" />
            <div class="sidebar-brand-text">FASSET</div>
            <button type="button" class="sidebar-pin-btn" onclick="toggleSidebarPin(event)" title="Pin sidebar open">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="17" x2="12" y2="22"></line><path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z"></path></svg>
            </button>
        </div>
        <div class="sidebar-divider"></div>
        <nav class="sidebar-nav">
            <div class="sidebar-section-label">Check-In</div>
            <a href="@Url.Action("Index", "Registration")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="12" r="9" /></svg>
                Check In
            </a>

            <div class="sidebar-section-label">Reports</div>
            <a href="@Url.Action("Index", "Reports")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
                Dashboard
            </a>
            <a href="@Url.Action("AttendanceDetail", "Reports")" class="sidebar-link active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M3 10h18M8 2v4M16 2v4" stroke-linecap="round" /></svg>
                Attendance Detail
            </a>

            <div class="sidebar-section-label">Manage</div>
            <a href="@Url.Action("Calendar", "Schedule")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round" /><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01" stroke-linecap="round" /></svg>
                Schedule
            </a>
            <a href="@Url.Action("Index", "Employees")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0113 0" stroke-linecap="round" /><path d="M16 4.5a3.5 3.5 0 010 7M22 20a6 6 0 00-4.5-8.7" stroke-linecap="round" /></svg>
                Employee Management
            </a>
            <a href="@Url.Action("Directory", "Employees")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87M9 7a4 4 0 118 0 4 4 0 01-8 0z" stroke-linecap="round" stroke-linejoin="round" /><circle cx="9" cy="17" r="4" /></svg>
                FASSET Employees
            </a>

            <div class="sidebar-section-label">Fasset Offices</div>
            @{ var fassetOffices = new[] { "Bank SETA", "FoodBev", "Tehwane South TVET College - Centurion Campus" }; }
            @foreach (var office in fassetOffices)
            {
                <a href="@Url.Action("Office", "Reports", new { name = office })" class="sidebar-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.5-7-11a7 7 0 0114 0c0 4.5-7 11-7 11z" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="10" r="2.5" /></svg>@office</a>
            }

            <div class="sidebar-section-label">Account</div>
            <a href="@Url.Action("Index", "Settings")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09a1.65 1.65 0 001.51-1 1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z" /></svg>
                Settings
            </a>
            <a href="@Url.Action("CreateAdmin", "Account")" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" stroke-linecap="round" /><circle cx="12" cy="7" r="4" /></svg>
                Create Admin
            </a>
            <a href="#" class="sidebar-link" onclick="document.getElementById('logOutForm').submit(); return false;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" stroke-linecap="round" stroke-linejoin="round" /><path d="M16 17l5-5-5-5M21 12H9" stroke-linecap="round" stroke-linejoin="round" /></svg>
                Log Out
            </a>
            @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logOutForm", style = "display:none;" })) { }
        </nav>
    </div>

    <div class="main-content">
        <div class="topnav">
            <div class="topnav-title"><a href="@Url.Action("Index", "Reports")">FASSET&reg; CHECK-IN REPORTS</a> &rsaquo; Attendance Detail</div>
            <button type="button" class="topnav-icon-btn" title="Refresh" onclick="loadAttendanceDetail()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0115.3-6.4L21 8M3 12a9 9 0 0015.3 6.4L21 16M21 3v5h-5M3 21v-5h5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
        </div>
        <div class="topnav-gradient-line"></div>

        <div class="typed-section">
            <p>FASSET is <span class="typed-text"></span><span class="cursor">&nbsp;</span></p>
        </div>

        <div class="hero-wrap">
            <div class="hero-chart-card">
                <div class="hero-chart-eyebrow">This period</div>
                <div class="hero-chart-value" id="heroTotalValue">-</div>
                <div class="hero-gear-wrap">
                    <button type="button" class="hero-gear-btn" onclick="loadAttendanceDetail()">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M3 12a9 9 0 0115.3-6.4L21 8M3 12a9 9 0 0015.3 6.4L21 16M21 3v5h-5M3 21v-5h5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </button>
                </div>
                <canvas id="heroTrendChart" height="80"></canvas>
            </div>

            <div class="exec-kpi-row">
                <div class="exec-kpi-card border-gold">
                    <div class="exec-kpi-label">Expected Today</div>
                    <div class="exec-kpi-value" id="kpiExpectedToday">-</div>
                    <div class="exec-kpi-delta" id="kpiExpectedTodayDelta">-</div>
                </div>
                <div class="exec-kpi-card border-teal">
                    <div class="exec-kpi-label">Checked In</div>
                    <div class="exec-kpi-value" id="kpiCheckedIn">-</div>
                    <div class="exec-kpi-delta" id="kpiCheckedInDelta">-</div>
                </div>
                <div class="exec-kpi-card border-green">
                    <div class="exec-kpi-label">Check-In Rate</div>
                    <div class="exec-kpi-value" id="kpiCheckInRate">-</div>
                    <div class="exec-kpi-delta" id="kpiCheckInRateDelta">-</div>
                </div>
                <div class="exec-kpi-card border-green">
                    <div class="exec-kpi-label">On Time</div>
                    <div class="exec-kpi-value" id="kpiOnTime">-</div>
                    <div class="exec-kpi-delta" id="kpiOnTimeDelta">-</div>
                </div>
                <div class="exec-kpi-card border-red">
                    <div class="exec-kpi-label">Not Checked In</div>
                    <div class="exec-kpi-value" id="kpiNotCheckedIn">-</div>
                    <div class="exec-kpi-delta warn">Needs review</div>
                </div>
            </div>
        </div>

        <div id="loadingNote" class="loading-note">Loading&hellip;</div>

        <div class="attendance-filters">
            <div class="filter-field">
                <label for="attStartDate">From</label>
                <input type="date" id="attStartDate" />
            </div>
            <div class="filter-field">
                <label for="attEndDate">To</label>
                <input type="date" id="attEndDate" />
            </div>
            <div class="filter-field">
                <label for="attDepartment">Department</label>
                <select id="attDepartment">
                    <option value="">All departments</option>
                    @if (departments != null)
                    {
                        foreach (var dept in departments)
                        {
                            <option value="@dept">@dept</option>
                        }
                    }
                </select>
            </div>
            <div class="filter-field">
                <label for="attLocation">Location</label>
                <select id="attLocation">
                    <option value="">All locations</option>
                    <option value="FoodBev">FoodBev</option>
                    <option value="Bank SETA">Bank SETA</option>
                    <option value="Tehwane South TVET College - Centurion Campus">Centurion Campus</option>
                    <option value="OutOfBounds">Out of Bounds</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="attStatus">Status</label>
                <select id="attStatus">
                    <option value="">All</option>
                    <option value="ontime">On time</option>
                    <option value="late">Late</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="attLocationStatus">Location Status</label>
                <select id="attLocationStatus">
                    <option value="">All</option>
                    <option value="inbound">Inbound</option>
                    <option value="outbound">Outbound</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="attRadiusBand">Radius</label>
                <select id="attRadiusBand">
                    <option value="">All</option>
                    <option value="normal">Normal (&le;150m)</option>
                    <option value="amber">Amber (151-200m)</option>
                    <option value="red">Red (&gt;200m)</option>
                </select>
            </div>
            <button id="attApplyBtn" onclick="loadAttendanceDetail()">Apply</button>
            <button id="attExportBtn" onclick="exportAttendanceDetail()">Export to Excel</button>
            <button id="attExportBtn" type="button" onclick="exportAttendanceDetail()">Export to Excel</button>
        </div>

        <div class="table-card">
            <table>
                <thead>
                    <tr><th>Employee</th><th>Department</th><th>Location</th><th>Location Status</th><th>Radius</th><th>Scheduled</th><th>Date &amp; Time</th><th>Status</th></tr>
                </thead>
                <tbody id="attendanceDetailBody"></tbody>
            </table>
            <div class="attendance-pagination">
                <div style="display:flex; gap:6px;">
                    <button type="button" class="modal-page-btn" id="attHomeBtn" onclick="attendanceGoToPage(1)">Home</button>
                    <button type="button" class="modal-page-btn" id="attPrevBtn" onclick="attendanceChangePage(-1)">Previous</button>
                </div>
                <span class="modal-page-info" id="attPageInfo">Page 1 of 1</span>
                <div style="display:flex; gap:6px;">
                    <button type="button" class="modal-page-btn" id="attNextBtn" onclick="attendanceChangePage(1)">Next</button>
                    <button type="button" class="modal-page-btn" id="attEndBtn" onclick="attendanceGoToLastPage()">End</button>
                </div>
            </div>
        </div>

        <div class="footer-space"></div>
    </div>

    <script>
        function toLocalDateStr(d) {
            var y = d.getFullYear();
            var m = String(d.getMonth() + 1).padStart(2, '0');
            var day = String(d.getDate()).padStart(2, '0');
            return y + '-' + m + '-' + day;
        }
        function todayStr() { return new Date().toISOString().slice(0, 10); }
        function daysAgoStr(n) {
            var d = new Date();
            d.setDate(d.getDate() - n);
            return d.toISOString().slice(0, 10);
        }

        var charts = {};
        function destroyChart(id) { if (charts[id]) { charts[id].destroy(); } }

        function renderHeroChart(labels, data) {
            destroyChart('heroTrendChart');
            var ctx = document.getElementById('heroTrendChart').getContext('2d');
            var gradient = ctx.createLinearGradient(0, 0, 0, 200);
            gradient.addColorStop(0, 'rgba(255,255,255,0.25)');
            gradient.addColorStop(1, 'rgba(255,255,255,0)');
            charts['heroTrendChart'] = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Data', data: data, borderColor: '#fff', backgroundColor: gradient,
                        fill: true, tension: 0.4, pointRadius: 4, pointHoverRadius: 7,
                        pointBackgroundColor: '#fff', pointBorderColor: '#1b3f6e', pointBorderWidth: 2, borderWidth: 2.5
                    }]
                },
                options: {
                    responsive: true,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            enabled: true, backgroundColor: '#fff', titleColor: '#23303d', bodyColor: '#23303d',
                            borderColor: '#e6ebf1', borderWidth: 1, cornerRadius: 8, padding: 10
                        }
                    },
                    scales: {
                        x: { ticks: { color: 'rgba(255,255,255,0.7)' }, grid: { color: 'rgba(255,255,255,0.08)' } },
                        y: { ticks: { color: 'rgba(255,255,255,0.7)' }, grid: { color: 'rgba(255,255,255,0.08)' }, beginAtZero: true }
                    }
                }
            });
        }

        // ---- Row 1 Executive KPIs, same logic as the Dashboard - deltas
        // come from a second fetch of the immediately preceding period of
        // equal length, using this page's own filter values. ----
        function getTotalHeadcount(d) {
            return (d.attendanceRateByDepartment || []).reduce(function (sum, r) { return sum + r.headcount; }, 0);
        }

        function setDeltaText(elId, current, previous, mode) {
            var el = document.getElementById(elId);
            if (previous === null || previous === undefined || isNaN(previous)) {
                el.textContent = '\u2014';
                el.className = 'exec-kpi-delta';
                return;
            }
            var diff = current - previous;
            var pct = previous !== 0 ? (diff / previous * 100) : (current > 0 ? 100 : 0);
            var arrow = diff > 0 ? '\u2191' : (diff < 0 ? '\u2193' : '\u2192');
            var text = mode === 'points'
                ? (arrow + ' ' + Math.abs(diff).toFixed(1) + ' pts vs prev.')
                : mode === 'count'
                    ? (arrow + ' ' + Math.abs(diff) + ' vs prev.')
                    : (arrow + ' ' + Math.abs(pct).toFixed(1) + '% vs prev.');
            el.textContent = text;
            el.className = 'exec-kpi-delta' + (diff < 0 ? ' down' : '');
        }

        function renderExecKpiRow(data, start, end, department, location, lateAfter) {
            var totalHeadcount = getTotalHeadcount(data);
            var checkedIn = data.summary.uniqueEmployees;
            var checkInRatePct = totalHeadcount > 0 ? (100 * checkedIn / totalHeadcount) : null;
            var onTime = data.lateVsOnTime.onTime;
            var onTimeTotal = data.lateVsOnTime.onTime + data.lateVsOnTime.late;
            var onTimeRatePct = onTimeTotal > 0 ? (100 * onTime / onTimeTotal) : null;
            var notCheckedIn = Math.max(0, totalHeadcount - checkedIn);

            document.getElementById('kpiExpectedToday').textContent = totalHeadcount;
            document.getElementById('kpiCheckedIn').textContent = checkedIn;
            document.getElementById('kpiCheckInRate').textContent = checkInRatePct !== null ? checkInRatePct.toFixed(1) + '%' : '-';
            document.getElementById('kpiOnTime').textContent = onTime;
            document.getElementById('kpiOnTimeDelta').textContent = onTimeRatePct !== null ? onTimeRatePct.toFixed(1) + '% on-time rate' : '-';
            document.getElementById('kpiNotCheckedIn').textContent = notCheckedIn;

            var startD = new Date(start), endD = new Date(end);
            var rangeDays = Math.max(1, Math.round((endD - startD) / 86400000) + 1);
            var prevEnd = new Date(startD); prevEnd.setDate(prevEnd.getDate() - 1);
            var prevStart = new Date(prevEnd); prevStart.setDate(prevStart.getDate() - (rangeDays - 1));

            var prevUrl = '@Url.Action("Data", "Reports")'
                + '?start=' + encodeURIComponent(toLocalDateStr(prevStart))
                + '&end=' + encodeURIComponent(toLocalDateStr(prevEnd))
                + '&department=' + encodeURIComponent(department)
                + '&location=' + encodeURIComponent(location)
                + '&lateAfter=' + encodeURIComponent(lateAfter);

            fetch(prevUrl).then(function (res) { return res.json(); }).then(function (prevData) {
                var prevHeadcount = getTotalHeadcount(prevData);
                var prevCheckedIn = prevData.summary.uniqueEmployees;
                var prevRatePct = prevHeadcount > 0 ? (100 * prevCheckedIn / prevHeadcount) : null;
                setDeltaText('kpiExpectedTodayDelta', totalHeadcount, prevHeadcount, 'count');
                setDeltaText('kpiCheckedInDelta', checkedIn, prevCheckedIn, 'percent');
                if (checkInRatePct !== null && prevRatePct !== null) {
                    setDeltaText('kpiCheckInRateDelta', checkInRatePct, prevRatePct, 'points');
                } else {
                    document.getElementById('kpiCheckInRateDelta').textContent = '\u2014';
                }
            }).catch(function () {
                ['kpiExpectedTodayDelta', 'kpiCheckedInDelta', 'kpiCheckInRateDelta'].forEach(function (id) {
                    document.getElementById(id).textContent = '\u2014';
                });
            });
        }

        // ---- Raw check-in log + pagination ----
        var attendanceState = { rows: [], page: 1, pageSize: 20 };
        var employeeHistoryBaseUrl = '@Url.Action("History", "Employees")';

        function loadAttendanceDetail() {
            var start = document.getElementById('attStartDate').value;
            var end = document.getElementById('attEndDate').value;
            var department = document.getElementById('attDepartment').value;
            var location = document.getElementById('attLocation').value;
            var status = document.getElementById('attStatus').value;
            var locationStatus = document.getElementById('attLocationStatus').value;
            var radiusBand = document.getElementById('attRadiusBand').value;
            // Not user-editable on this page - kept at the app-wide default
            // so isLate is computed the same way everywhere else.
            var lateAfter = '09:00';
            var loadingNote = document.getElementById('loadingNote');

            loadingNote.style.display = 'block';

            var url = '@Url.Action("Data", "Reports")'
                + '?start=' + encodeURIComponent(start)
                + '&end=' + encodeURIComponent(end)
                + '&department=' + encodeURIComponent(department)
                + '&location=' + encodeURIComponent(location)
                + '&locationStatus=' + encodeURIComponent(locationStatus)
                + '&radiusBand=' + encodeURIComponent(radiusBand)
                + '&lateAfter=' + encodeURIComponent(lateAfter);

            fetch(url).then(function (res) { return res.json(); }).then(function (data) {
                loadingNote.style.display = 'none';

                document.getElementById('heroTotalValue').textContent = data.summary.totalCheckIns + ' check-ins';
                renderHeroChart(data.byWeek.map(function (d) { return d.label; }), data.byWeek.map(function (d) { return d.count; }));
                renderExecKpiRow(data, start, end, department, location, lateAfter);

                var rows = data.checkInDetails || [];
                if (status === 'ontime') { rows = rows.filter(function (r) { return !r.isLate; }); }
                else if (status === 'late') { rows = rows.filter(function (r) { return r.isLate; }); }

                attendanceState.rows = rows.slice().reverse();
                attendanceState.page = 1;
                renderAttendancePage();
            }).catch(function (err) {
                loadingNote.style.display = 'none';
                console.error('Could not load attendance detail', err);
                alert('Could not load attendance detail. Check the browser console for details.');
            });
        }

        function renderAttendancePage() {
            var start = (attendanceState.page - 1) * attendanceState.pageSize;
            var pageRows = attendanceState.rows.slice(start, start + attendanceState.pageSize);
            var body = document.getElementById('attendanceDetailBody');
            body.innerHTML = '';
            if (pageRows.length === 0) {
                body.innerHTML = '<tr><td colspan="8" style="color:#99a3b3; text-align:center; padding:24px;">No check-ins match these filters.</td></tr>';
            } else {
                pageRows.forEach(function (r) {
                    var tr = document.createElement('tr');
                    // Known place names/addresses link out to Google Maps;
                    // "Unknown / location denied" has no coordinates to
                    // link to, so it stays plain text.
                    var locationCell = r.location === 'Unknown / location denied'
                        ? r.location
                        : '<a href="https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(r.location) + '" target="_blank" rel="noopener" style="color:#1b3f6e; text-decoration:underline;">' + r.location + '</a>';

                    // Radius: distance in meters to the nearest configured
                    // site. Color bands: <=150m normal (matches Inbound),
                    // 151-200m amber,
                    // >200m red. No coordinate to measure from -> "-".
                    var radiusCell;
                    if (r.distanceMeters === null || r.distanceMeters === undefined) {
                        radiusCell = '<span style="color:#99a3b3;">-</span>';
                    } else {
                        var radiusColor = r.distanceMeters <= 150 ? '#23303d' : (r.distanceMeters <= 200 ? '#e07b39' : '#e05043');
                        radiusCell = '<span style="color:' + radiusColor + '; font-weight:600;">' + r.distanceMeters + 'm</span>';
                    }

                    // Scheduled: was this employee actually rostered on
                    // this date (regardless of which site)? Tick/cross,
                    // not a link - just a quick visual flag.
                    var scheduledCell = r.wasScheduled
                        ? '<span style="color:#2e9e4a; font-weight:700;">&#10003;</span>'
                        : '<span style="color:#e05043; font-weight:700;">&#10007;</span>';

                    // Employee name links to their monthly history page.
                    var employeeCell = '<a href="' + employeeHistoryBaseUrl + '?name=' + encodeURIComponent(r.employeeName) + '" style="color:#1b3f6e; text-decoration:underline; font-weight:600;">' + r.employeeName + '</a>';

                    tr.innerHTML =
                        '<td>' + employeeCell + '</td>' +
                        '<td>' + r.departmentName + '</td>' +
                        '<td>' + locationCell + '</td>' +
                        '<td style="color:' + (r.locationStatus === 'Inbound' ? '#2e9e4a' : '#e07b39') + '; font-weight:600;">' + r.locationStatus + '</td>' +
                        '<td>' + radiusCell + '</td>' +
                        '<td>' + scheduledCell + '</td>' +
                        '<td>' + r.time + '</td>' +
                        '<td style="color:' + (r.isLate ? '#e05043' : '#2e9e4a') + '; font-weight:600;">' + (r.isLate ? 'Late' : 'On time') + '</td>';
                    body.appendChild(tr);
                });
            }

            var totalPages = Math.max(1, Math.ceil(attendanceState.rows.length / attendanceState.pageSize));
            document.getElementById('attPageInfo').textContent = 'Page ' + attendanceState.page + ' of ' + totalPages + ' (' + attendanceState.rows.length + ' check-ins)';
            document.getElementById('attPrevBtn').disabled = attendanceState.page <= 1;
            document.getElementById('attNextBtn').disabled = attendanceState.page >= totalPages;
            document.getElementById('attHomeBtn').disabled = attendanceState.page <= 1;
            document.getElementById('attEndBtn').disabled = attendanceState.page >= totalPages;
        }

        function attendanceChangePage(delta) {
            var totalPages = Math.max(1, Math.ceil(attendanceState.rows.length / attendanceState.pageSize));
            attendanceState.page = Math.min(totalPages, Math.max(1, attendanceState.page + delta));
            renderAttendancePage();
        }

        function attendanceGoToPage(page) {
            attendanceState.page = page;
            renderAttendancePage();
        }

        function attendanceGoToLastPage() {
            var totalPages = Math.max(1, Math.ceil(attendanceState.rows.length / attendanceState.pageSize));
            attendanceState.page = totalPages;
            renderAttendancePage();
        }

        // Exports the SAME filtered set currently shown in the table -
        // reuses the existing ExportExcel action with the same filter
        // values, rather than a separate export-specific endpoint.
        function exportAttendanceDetail() {
            var start = document.getElementById('attStartDate').value;
            var end = document.getElementById('attEndDate').value;
            var department = document.getElementById('attDepartment').value;
            var location = document.getElementById('attLocation').value;
            var locationStatus = document.getElementById('attLocationStatus').value;
            var radiusBand = document.getElementById('attRadiusBand').value;
            var lateAfter = '09:00';

            var url = '@Url.Action("ExportExcel", "Reports")'
                + '?start=' + encodeURIComponent(start)
                + '&end=' + encodeURIComponent(end)
                + '&department=' + encodeURIComponent(department)
                + '&location=' + encodeURIComponent(location)
                + '&locationStatus=' + encodeURIComponent(locationStatus)
                + '&radiusBand=' + encodeURIComponent(radiusBand)
                + '&lateAfter=' + encodeURIComponent(lateAfter);
            window.location.href = url;
        }

        document.getElementById('attStartDate').value = daysAgoStr(30);
        document.getElementById('attEndDate').value = todayStr();
        loadAttendanceDetail();

        const typedTextSpan = document.querySelector(".typed-text");
        const cursorSpan = document.querySelector(".cursor");
        const textArray = [
            "e-CheckIn",
            "striving for excellence through hard work",
            "working with honesty and integrity",
            "making a difference",
            "valuing people",
            "innovation"
        ];
        const typingDelay = 60;
        const erasingDelay = 30;
        const newTextDelay = 2500;
        let textArrayIndex = 0;
        let charIndex = 0;

        function type() {
            if (charIndex < textArray[textArrayIndex].length) {
                if (!cursorSpan.classList.contains("typing")) cursorSpan.classList.add("typing");
                typedTextSpan.textContent += textArray[textArrayIndex].charAt(charIndex);
                charIndex++;
                setTimeout(type, typingDelay);
            } else {
                cursorSpan.classList.remove("typing");
                setTimeout(erase, newTextDelay);
            }
        }

        function erase() {
            if (charIndex > 0) {
                if (!cursorSpan.classList.contains("typing")) cursorSpan.classList.add("typing");
                typedTextSpan.textContent = textArray[textArrayIndex].substring(0, charIndex - 1);
                charIndex--;
                setTimeout(erase, erasingDelay);
            } else {
                cursorSpan.classList.remove("typing");
                textArrayIndex++;
                if (textArrayIndex >= textArray.length) textArrayIndex = 0;
                setTimeout(type, typingDelay + 1100);
            }
        }

        if (textArray.length && typedTextSpan && cursorSpan) {
            setTimeout(type, newTextDelay + 250);
        }

        function toggleSidebarPin(e) {
            e.stopPropagation();
            var sidebar = document.querySelector('.sidebar');
            var isPinned = sidebar.classList.toggle('pinned');
            localStorage.setItem('sidebarPinned', isPinned ? '1' : '0');
        }
        (function () {
            if (localStorage.getItem('sidebarPinned') === '1') {
                var sb = document.querySelector('.sidebar');
                if (sb) { sb.classList.add('pinned'); }
            }
        })();
    </script>
</body>
</html>
