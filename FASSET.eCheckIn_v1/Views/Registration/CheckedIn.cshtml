@{
    Layout = null;
    string checkedInName = ViewBag.CheckedInName as string;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>FASSET&reg; - Checked In</title>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
    <style>
        body {
            margin: 0;
            background-color: #0f7fa3;
            font-family: Arial, sans-serif;
        }

        .content {
            background: #ffffff;
            max-width: 420px;
            margin: 60px auto;
            padding: 0 0 32px 0;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.25);
            overflow: hidden;
            text-align: center;
        }

        .cld-responsive {
            width: 100%;
            display: block;
        }

        .checkmark-circle {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background-color: #4caf50;
            color: #fff;
            font-size: 40px;
            line-height: 72px;
            margin: 28px auto 14px auto;
        }

        h1 {
            font-size: 22px;
            margin: 0 24px 6px 24px;
            color: #1b3f6e;
        }

        p {
            font-size: 15px;
            color: #444;
            margin: 0 24px 24px 24px;
        }

        #closeNote {
            color: #444;
        }

        @@import url('https://fonts.googleapis.com/css?family=Montserrat');

        .typed-section {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 32px 16px 16px;
        }

            .typed-section p {
                font-family: 'Montserrat', sans-serif;
                font-size: 1.75rem;
                font-weight: bold;
                letter-spacing: 0.05rem;
                text-align: center;
                color: #ffffff;
                overflow: hidden;
                margin: 0;
            }

                .typed-section p span.typed-text {
                    font-weight: normal;
                    color: #FDE68A;
                }

                .typed-section p span.cursor {
                    display: inline-block;
                    background-color: #ffffff;
                    margin-left: 0.1rem;
                    width: 3px;
                    animation: blink 1s infinite;
                }

                    .typed-section p span.cursor.typing {
                        animation: none;
                    }

        @@keyframes blink {
            0% {
                background-color: #ffffff;
            }

            49% {
                background-color: #ffffff;
            }

            50% {
                background-color: transparent;
            }

            99% {
                background-color: transparent;
            }

            100% {
                background-color: #ffffff;
            }
        }

        @@media (max-width: 500px) {
            .typed-section p {
                font-size: 1.25rem;
            }
        }
    </style>
</head>
<body>
    <div class="content">
        <img class="cld-responsive" alt="header-image" src="~/Content/FASSET_HD.jpg" />
        <div class="checkmark-circle">&#10003;</div>
        <h1>@(string.IsNullOrEmpty(checkedInName) ? "You're checked in!" : checkedInName + ", you're checked in!")</h1>
        <p>Thanks &mdash; your check-in has been recorded.</p>
        <p id="closeNote">You're all set. You can put your phone away now, or close this tab if you'd like &mdash; either way, there's nothing else to do here.</p>
    </div>

    <div class="typed-section">
        <p>FASSET is <span class="typed-text"></span><span class="cursor">&nbsp;</span></p>
    </div>

    <script>
        // Quietly try to close the tab in case this one WAS opened by
        // script (window.open) - most mobile browsers block this for tabs
        // reached by scanning a QR code or typing a URL directly, since
        // that's a security restriction with no workaround, not a bug.
        // Either way the page above already reads correctly regardless of
        // whether this succeeds, so there's no button pretending to do
        // something that usually can't happen.
        window.addEventListener('load', function () {
            setTimeout(function () {
                window.close();
            }, 400);
        });

        function fireConfetti() {
            if (typeof confetti !== 'function') {
                return; // CDN failed to load - fail silently, don't break the page
            }
            var brandColors = ['#1b3f6e', '#f2c40c', '#ffffff', '#0f7fa3'];
            // Center burst
            confetti({
                particleCount: 120,
                spread: 90,
                origin: { y: 0.5 },
                colors: brandColors
            });
            // Side bursts, slightly delayed, for a fuller effect
            setTimeout(function () {
                confetti({
                    particleCount: 60,
                    angle: 60,
                    spread: 70,
                    origin: { x: 0, y: 0.6 },
                    colors: brandColors
                });
                confetti({
                    particleCount: 60,
                    angle: 120,
                    spread: 70,
                    origin: { x: 1, y: 0.6 },
                    colors: brandColors
                });
            }, 250);
        }
        window.addEventListener('load', fireConfetti);

        const typedTextSpan = document.querySelector(".typed-text");
        const cursorSpan = document.querySelector(".cursor");
        const textArray = [
            "e-CheckIn",
            "striving for excellence through hard work",
            "working with honesty and integrity",
            "making a difference",
            "valuing people",
            "innovation"
        ];
        const typingDelay = 60;
        const erasingDelay = 30;
        const newTextDelay = 2500;
        let textArrayIndex = 0;
        let charIndex = 0;

        function type() {
            if (charIndex < textArray[textArrayIndex].length) {
                if (!cursorSpan.classList.contains("typing")) cursorSpan.classList.add("typing");
                typedTextSpan.textContent += textArray[textArrayIndex].charAt(charIndex);
                charIndex++;
                setTimeout(type, typingDelay);
            } else {
                cursorSpan.classList.remove("typing");
                setTimeout(erase, newTextDelay);
            }
        }

        function erase() {
            if (charIndex > 0) {
                if (!cursorSpan.classList.contains("typing")) cursorSpan.classList.add("typing");
                typedTextSpan.textContent = textArray[textArrayIndex].substring(0, charIndex - 1);
                charIndex--;
                setTimeout(erase, erasingDelay);
            } else {
                cursorSpan.classList.remove("typing");
                textArrayIndex++;
                if (textArrayIndex >= textArray.length) textArrayIndex = 0;
                setTimeout(type, typingDelay + 1100);
            }
        }

        if (textArray.length && typedTextSpan && cursorSpan) {
            setTimeout(type, newTextDelay + 250);
        }
    </script>
</body>
</html>
