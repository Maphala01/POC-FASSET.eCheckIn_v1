@model FASSET.eCheckIn_v1.Models.QRCodeModel

@section head {
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>Daily QR Code</title>
    <style>
        .qr-page {
            text-align: center;
            padding: 120px 0 4px;
        }

            .qr-page h2 {
                font-size: 20px;
                margin: 0 0 14px 0;
                color: #1E293B;
            }

        .qr-code {
            max-width: 620px;
            width: 100%;
            height: auto;
        }
    </style>
}

<div class="qr-page">
    @if (ViewBag.QRError != null)
    {
        <p style="color:red;">@ViewBag.QRError</p>
    }
    else if (ViewBag.QRCodeExpired != null)
    {
        <h2>QR Code Expired</h2>
        <p>The QR code you are trying to access has expired.</p>
    }
    else if (Model.QRCodeImageUrl != null)
    {
        <h2>
            Scan the QR Code to visit FASSET<span>&reg;</span> Echeck-In
            <span id="date-display"></span>
        </h2>
        <img class="qr-code" src="@Model.QRCodeImageUrl" alt="Daily QR Code" />
    }
    else
    {
        <p style="color:orange;">QR code URL was not generated. Check server logs.</p>
    }
</div>

@section scripts {
    <script>
        // Reloads the page once the current QR code's validity window ends,
        // so a stale/expired code is never left on screen unattended.
        function updateTimer() {
            var timerElement = document.getElementById("timer");
            if (!timerElement) return;
            var timeLeft = parseInt(timerElement.innerText);
            if (timeLeft > 0) {
                timerElement.innerText = timeLeft - 1;
            } else {
                window.location.reload(true);
            }
        }
        setInterval(updateTimer, 1000);

        function displayTodayDate() {
            const today = new Date();
            const year = today.getFullYear();
            const month = String(today.getMonth() + 1).padStart(2, '0');
            const day = String(today.getDate()).padStart(2, '0');
            const formattedDate = `${year}-${month}-${day}`;
            var el = document.getElementById('date-display');
            if (el) el.textContent = formattedDate;
        }
        displayTodayDate();
    </script>
}
